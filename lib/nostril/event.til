mode lib

crypto := import("std/crypto")
import("std/crypto", CryptoError)

getrandom := ext_proc(mut buf: Dynamic, shallow count: USize,
    shallow flags: U32) returns shallow I64 {}
time := ext_proc(mut out: Dynamic) returns shallow I64 {}

priv JsonCursor := struct {
    text : Str = ""
    at : USize = 0
}

priv NostrEventFields := struct {
    id : Str = ""
    pubkey : Str = ""
    created_at : I64 = 0
    kind : I64 = 0
    tags : Str = ""
    content : Str = ""
    sig : Str = ""
    has_id := false
    has_pubkey := false
    has_created_at := false
    has_kind := false
    has_tags := false
    has_content := false
    has_sig := false
}

priv nostril_utf8 := func(code: I64) returns Str {
    if code < 0 || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff) {
        return ""
    }
    if code < 128 { return Str.from_byte(code.to_u8()) }
    if code < 2048 {
        return format(Str.from_byte((192 + code / 64).to_u8()),
            Str.from_byte((128 + code.mod(64)).to_u8()))
    }
    if code < 65536 {
        return format(Str.from_byte((224 + code / 4096).to_u8()),
            Str.from_byte((128 + (code / 64).mod(64)).to_u8()),
            Str.from_byte((128 + code.mod(64)).to_u8()))
    }
    return format(Str.from_byte((240 + code / 262144).to_u8()),
        Str.from_byte((128 + (code / 4096).mod(64)).to_u8()),
        Str.from_byte((128 + (code / 64).mod(64)).to_u8()),
        Str.from_byte((128 + code.mod(64)).to_u8()))
}

priv json_skip_ws := func(mut cursor: JsonCursor) {
    while cursor.at < cursor.text.len() {
        ref byte : I8 = cursor.text[cursor.at]
        if byte != ' ' && byte != '\n' && byte != '\r' && byte != '\t' { return }
        cursor.at++
    }
}

priv json_take := func(mut cursor: JsonCursor, wanted: I8) returns Bool {
    json_skip_ws(cursor)
    if cursor.at >= cursor.text.len() || cursor.text[cursor.at] != wanted { return false }
    cursor.at++
    return true
}

priv json_hex_value := func(byte: I8) returns I64 {
    if byte >= '0' && byte <= '9' { return (byte - '0').cast(I64) }
    if byte >= 'a' && byte <= 'f' { return (byte - 'a').cast(I64) + 10 }
    if byte >= 'A' && byte <= 'F' { return (byte - 'A').cast(I64) + 10 }
    return -1
}

priv json_hex_quad := func(mut cursor: JsonCursor, mut value: I64) returns Bool {
    if cursor.at + 4 > cursor.text.len() { return false }
    value = 0
    four : USize = 4
    for _i in 0..four {
        digit := json_hex_value(cursor.text[cursor.at])
        if digit < 0 { return false }
        value = value * 16 + digit
        cursor.at++
    }
    return true
}

priv nostril_utf8_width := func(text: Str, at: USize, mut width: USize) returns Bool {
    if at >= text.len() { return false }
    first := text[at].cast(U8).to_i64()
    if first < 0x80 { width = 1; return true }
    mut wanted : USize = 0
    if first >= 0xc2 && first <= 0xdf { wanted = 2 }
    else if first >= 0xe0 && first <= 0xef { wanted = 3 }
    else if first >= 0xf0 && first <= 0xf4 { wanted = 4 }
    else { return false }
    if at + wanted > text.len() { return false }
    second := text[at + 1].cast(U8).to_i64()
    if second < 0x80 || second > 0xbf { return false }
    if first == 0xe0 && second < 0xa0 { return false }
    if first == 0xed && second > 0x9f { return false }
    if first == 0xf0 && second < 0x90 { return false }
    if first == 0xf4 && second > 0x8f { return false }
    mut i : USize = 2
    while i < wanted {
        continuation := text[at + i].cast(U8).to_i64()
        if continuation < 0x80 || continuation > 0xbf { return false }
        i++
    }
    width = wanted
    return true
}

// Shared text validation for event content and application-owned account names.
nostril_valid_utf8 := func(text: Str) returns Bool {
    mut at : USize = 0
    while at < text.len() {
        mut width : USize = 0
        if !nostril_utf8_width(text, at, width) { return false }
        at = at + width
    }
    return true
}

priv nostril_utf8_scalars := func(text: Str) returns USize {
    mut at : USize = 0
    mut count : USize = 0
    while at < text.len() {
        mut width : USize = 0
        if !nostril_utf8_width(text, at, width) { return 0 }
        at = at + width
        count++
    }
    return count
}

priv json_parse_string := func(mut cursor: JsonCursor, mut out: Str) returns Bool {
    json_skip_ws(cursor)
    if cursor.at >= cursor.text.len() || cursor.text[cursor.at] != '"' { return false }
    cursor.at++
    mut end := cursor.at
    while end < cursor.text.len() && cursor.text[end] != '"' {
        if cursor.text[end] == '\\' {
            end++
            if end >= cursor.text.len() { return false }
        }
        end++
    }
    if end >= cursor.text.len() { return false }
    mut decoded := Str.with_capacity(end - cursor.at)
    while cursor.at < cursor.text.len() {
        ref byte : I8 = cursor.text[cursor.at]
        cursor.at++
        if byte == '"' {
            out = decoded
            return true
        }
        if byte.cast(U8).to_i64() < 0x20 { return false }
        if byte != '\\' {
            start := cursor.at - 1
            mut width : USize = 0
            if !nostril_utf8_width(cursor.text, start, width) { return false }
            decoded.push_str(cursor.text.substr(start, width))
            cursor.at = start + width
            continue
        }
        if cursor.at >= cursor.text.len() { return false }
        ref escaped : I8 = cursor.text[cursor.at]
        cursor.at++
        if escaped == '"' || escaped == '\\' || escaped == '/' {
            decoded.push_str(Str.from_byte(escaped.cast(U8)))
        } else if escaped == 'b' { decoded.push_str(Str.from_byte(8)) }
        else if escaped == 'f' { decoded.push_str(Str.from_byte(12)) }
        else if escaped == 'n' { decoded.push_str(Str.from_byte(10)) }
        else if escaped == 'r' { decoded.push_str(Str.from_byte(13)) }
        else if escaped == 't' { decoded.push_str(Str.from_byte(9)) }
        else if escaped == 'u' {
            mut code : I64 = 0
            if !json_hex_quad(cursor, code) { return false }
            if code >= 0xd800 && code <= 0xdbff {
                if cursor.at + 6 > cursor.text.len() ||
                    cursor.text[cursor.at] != '\\' || cursor.text[cursor.at + 1] != 'u' {
                    return false
                }
                cursor.at = cursor.at + 2
                mut low : I64 = 0
                if !json_hex_quad(cursor, low) || low < 0xdc00 || low > 0xdfff { return false }
                code = 0x10000 + (code - 0xd800) * 1024 + low - 0xdc00
            } else if code >= 0xdc00 && code <= 0xdfff { return false }
            decoded.push_str(nostril_utf8(code))
        } else { return false }
    }
    return false
}

priv json_quote := func(value: Str) returns Str {
    mut out := Str.with_capacity(value.len() * 6 + 2)
    out.push_str("\"")
    for byte : I8 in value {
        if byte == '"' { out.push_str("\\\"") }
        else if byte == '\\' { out.push_str("\\\\") }
        else if byte == '\n' { out.push_str("\\n") }
        else if byte == '\r' { out.push_str("\\r") }
        else if byte == '\t' { out.push_str("\\t") }
        else if byte.cast(U8).to_i64() == 8 { out.push_str("\\b") }
        else if byte.cast(U8).to_i64() == 12 { out.push_str("\\f") }
        else if byte.cast(U8).to_i64() < 0x20 {
            digits := "0123456789abcdef"
            n := byte.cast(U8).to_i64()
            out.push_str(format("\\u00", digits.substr((n / 16).to_usize(), 1),
                digits.substr(n.mod(16).to_usize(), 1)))
        } else { out.push_str(Str.from_byte(byte.cast(U8))) }
    }
    out.push_str("\"")
    return out
}

priv json_parse_nonnegative_i64 := func(mut cursor: JsonCursor, mut out: I64) returns Bool {
    json_skip_ws(cursor)
    if cursor.at >= cursor.text.len() { return false }
    ref first : I8 = cursor.text[cursor.at]
    if first < '0' || first > '9' { return false }
    if first == '0' && cursor.at + 1 < cursor.text.len() {
        ref next : I8 = cursor.text[cursor.at + 1]
        if next >= '0' && next <= '9' { return false }
    }
    mut value : I64 = 0
    while cursor.at < cursor.text.len() {
        ref byte : I8 = cursor.text[cursor.at]
        if byte < '0' || byte > '9' { break }
        digit := (byte - '0').cast(I64)
        if value > (I64.MAX - digit) / 10 { return false }
        value = value * 10 + digit
        cursor.at++
    }
    out = value
    return true
}

priv json_skip_number := func(mut cursor: JsonCursor) returns Bool {
    json_skip_ws(cursor)
    start := cursor.at
    if cursor.at < cursor.text.len() && cursor.text[cursor.at] == '-' { cursor.at++ }
    if cursor.at >= cursor.text.len() { return false }
    if cursor.text[cursor.at] == '0' { cursor.at++ }
    else {
        if cursor.text[cursor.at] < '1' || cursor.text[cursor.at] > '9' { return false }
        while cursor.at < cursor.text.len() && cursor.text[cursor.at] >= '0' &&
            cursor.text[cursor.at] <= '9' { cursor.at++ }
    }
    if cursor.at < cursor.text.len() && cursor.text[cursor.at] == '.' {
        cursor.at++
        digit_start := cursor.at
        while cursor.at < cursor.text.len() && cursor.text[cursor.at] >= '0' &&
            cursor.text[cursor.at] <= '9' { cursor.at++ }
        if cursor.at == digit_start { return false }
    }
    if cursor.at < cursor.text.len() &&
        (cursor.text[cursor.at] == 'e' || cursor.text[cursor.at] == 'E') {
        cursor.at++
        if cursor.at < cursor.text.len() &&
            (cursor.text[cursor.at] == '+' || cursor.text[cursor.at] == '-') { cursor.at++ }
        digit_start := cursor.at
        while cursor.at < cursor.text.len() && cursor.text[cursor.at] >= '0' &&
            cursor.text[cursor.at] <= '9' { cursor.at++ }
        if cursor.at == digit_start { return false }
    }
    return cursor.at > start
}

priv json_skip_value := func(mut cursor: JsonCursor, depth: I64) returns Bool {
    if depth > 64 { return false }
    json_skip_ws(cursor)
    if cursor.at >= cursor.text.len() { return false }
    ref byte : I8 = cursor.text[cursor.at]
    if byte == '"' {
        mut ignored := ""
        return json_parse_string(cursor, ignored)
    }
    if byte == '[' {
        cursor.at++
        json_skip_ws(cursor)
        if cursor.at < cursor.text.len() && cursor.text[cursor.at] == ']' {
            cursor.at++
            return true
        }
        while true {
            if !json_skip_value(cursor, depth + 1) { return false }
            json_skip_ws(cursor)
            if cursor.at < cursor.text.len() && cursor.text[cursor.at] == ']' {
                cursor.at++
                return true
            }
            if !json_take(cursor, ',') { return false }
        }
    }
    if byte == '{' {
        cursor.at++
        json_skip_ws(cursor)
        if cursor.at < cursor.text.len() && cursor.text[cursor.at] == '}' {
            cursor.at++
            return true
        }
        while true {
            mut key := ""
            if !json_parse_string(cursor, key) || !json_take(cursor, ':') ||
                !json_skip_value(cursor, depth + 1) { return false }
            json_skip_ws(cursor)
            if cursor.at < cursor.text.len() && cursor.text[cursor.at] == '}' {
                cursor.at++
                return true
            }
            if !json_take(cursor, ',') { return false }
        }
    }
    for literal : Str in array(Str, "true", "false", "null") {
        if cursor.text.substr(cursor.at, cursor.text.len() - cursor.at).starts_with(literal) {
            cursor.at = cursor.at + literal.len()
            return true
        }
    }
    return json_skip_number(cursor)
}

priv json_parse_tags := func(mut cursor: JsonCursor, mut canonical: Str) returns Bool {
    if !json_take(cursor, '[') { return false }
    mut out := Str.with_capacity(cursor.text.len() - cursor.at + 1)
    out.push_str("[")
    json_skip_ws(cursor)
    if cursor.at < cursor.text.len() && cursor.text[cursor.at] == ']' {
        cursor.at++
        canonical = "[]"
        return true
    }
    mut first_tag := true
    while true {
        if !json_take(cursor, '[') { return false }
        if !first_tag { out.push_str(",") }
        out.push_str("[")
        mut first_value := true
        while true {
            mut value := ""
            if !json_parse_string(cursor, value) { return false }
            if !first_value { out.push_str(",") }
            out.push_str(json_quote(value))
            first_value = false
            json_skip_ws(cursor)
            if cursor.at < cursor.text.len() && cursor.text[cursor.at] == ']' {
                cursor.at++
                break
            }
            if !json_take(cursor, ',') { return false }
        }
        if first_value { return false }
        out.push_str("]")
        first_tag = false
        json_skip_ws(cursor)
        if cursor.at < cursor.text.len() && cursor.text[cursor.at] == ']' {
            cursor.at++
            out.push_str("]")
            canonical = out
            return true
        }
        if !json_take(cursor, ',') { return false }
    }
    return false
}

priv nostril_parse_event := func(mut cursor: JsonCursor,
        mut fields: NostrEventFields) returns Bool {
    if !json_take(cursor, '{') { return false }
    json_skip_ws(cursor)
    if cursor.at < cursor.text.len() && cursor.text[cursor.at] == '}' { return false }
    while true {
        mut key := ""
        if !json_parse_string(cursor, key) || !json_take(cursor, ':') { return false }
        if key == "id" {
            if fields.has_id || !json_parse_string(cursor, fields.id) { return false }
            fields.has_id = true
        } else if key == "pubkey" {
            if fields.has_pubkey || !json_parse_string(cursor, fields.pubkey) { return false }
            fields.has_pubkey = true
        } else if key == "created_at" {
            if fields.has_created_at || !json_parse_nonnegative_i64(cursor, fields.created_at) { return false }
            fields.has_created_at = true
        } else if key == "kind" {
            if fields.has_kind || !json_parse_nonnegative_i64(cursor, fields.kind) { return false }
            fields.has_kind = true
        } else if key == "tags" {
            if fields.has_tags || !json_parse_tags(cursor, fields.tags) { return false }
            fields.has_tags = true
        } else if key == "content" {
            if fields.has_content || !json_parse_string(cursor, fields.content) { return false }
            fields.has_content = true
        } else if key == "sig" {
            if fields.has_sig || !json_parse_string(cursor, fields.sig) { return false }
            fields.has_sig = true
        } else if !json_skip_value(cursor, 0) { return false }
        json_skip_ws(cursor)
        if cursor.at < cursor.text.len() && cursor.text[cursor.at] == '}' {
            cursor.at++
            break
        }
        if !json_take(cursor, ',') { return false }
    }
    return fields.has_id && fields.has_pubkey && fields.has_created_at &&
        fields.has_kind && fields.has_tags && fields.has_content && fields.has_sig &&
        fields.kind <= 65535
}

priv nostril_is_lower_hex := func(value: Str, length: USize) returns Bool {
    if value.len() != length { return false }
    for byte : I8 in value {
        if !((byte >= '0' && byte <= '9') || (byte >= 'a' && byte <= 'f')) { return false }
    }
    return true
}

priv nostril_serialized_event := func(fields: NostrEventFields) returns Str {
    return format("[0,", json_quote(fields.pubkey), ",", fields.created_at.to_str(),
        ",", fields.kind.to_str(), ",", fields.tags, ",", json_quote(fields.content), "]")
}

priv nostril_valid_fields := proc(fields: NostrEventFields) returns Bool {
    if !nostril_is_lower_hex(fields.id, 64) ||
        !nostril_is_lower_hex(fields.pubkey, 64) ||
        !nostril_is_lower_hex(fields.sig, 128) { return false }
    digest := crypto.sha256_str(nostril_serialized_event(fields))
    if digest.to_hex() != fields.id { return false }
    mut valid := false
    mut bad_key := false
    valid = crypto.schnorr_verify(U256.from_hex(fields.pubkey), digest,
        crypto.Signature.from_hex(fields.sig))?
    catch (_error: CryptoError) { bad_key = true }
    return !bad_key && valid
}

priv nostril_parse_complete_event := func(event_json: Str,
        mut fields: NostrEventFields) returns Bool {
    mut cursor := JsonCursor(text = event_json.borrowed_view())
    if !nostril_parse_event(cursor, fields) { return false }
    json_skip_ws(cursor)
    return cursor.at == cursor.text.len()
}

priv nostril_parse_relay_event := func(message: Str,
        mut fields: NostrEventFields) returns Bool {
    mut cursor := JsonCursor(text = message.borrowed_view())
    if !json_take(cursor, '[') { return false }
    mut command := ""
    mut subscription := ""
    if !json_parse_string(cursor, command) || command != "EVENT" ||
        !json_take(cursor, ',') || !json_parse_string(cursor, subscription) ||
        subscription.len() == 0 || nostril_utf8_scalars(subscription) > 64 ||
        !json_take(cursor, ',') ||
        !nostril_parse_event(cursor, fields) || !json_take(cursor, ']') { return false }
    json_skip_ws(cursor)
    return cursor.at == cursor.text.len()
}

priv nostril_random_u256 := proc() returns U256 {
    mut value := U256()
    mut offset : USize = 0
    total : USize = 32
    while offset < total {
        got := getrandom(ptr_add(value, offset.cast(UPtr)), total - offset, 0)
        if got <= 0 { panic("getrandom failed while creating an ephemeral key") }
        offset = offset + got.to_usize()
    }
    return value
}

/// Generate a session key with operating-system entropy. Callers decide its lifetime.
nostril_generate_secret_key := proc() returns Str {
    zero := U256()
    order := U256.from_hex("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141")
    while true {
        key := nostril_random_u256()
        if U256.cmp(key, zero) > 0 && U256.cmp(key, order) < 0 { return key.to_hex() }
    }
    return ""
}

/// Derive a lowercase BIP-340 x-only public key from a secret key.
nostril_pubkey := proc(secret_key: Str) returns Str {
    if !nostril_is_lower_hex(secret_key, 64) { panic("invalid Nostr secret key encoding") }
    return crypto.schnorr_pubkey(U256.from_hex(secret_key))!.to_hex()
}

/// Current Unix timestamp in seconds.
nostril_now := proc() returns I64 {
    now := time(to_ptr(0))
    if now < 0 { panic("could not read the current Unix timestamp") }
    return now
}

/// Create and sign a kind-1 NIP-01 event with no tags.
nostril_sign_text_note := proc(secret_key: Str, content: Str, created_at: I64) returns Str {
    if created_at < 0 { panic("a Nostr event timestamp cannot be negative") }
    if !nostril_valid_utf8(content) { panic("Nostr event content must be valid UTF-8") }
    pubkey := nostril_pubkey(secret_key)
    // These temporary fields must not take ownership of the caller's composer.
    // Serialization finishes before this borrow ends; the returned JSON owns
    // its own bytes independently of the input.
    mut fields := NostrEventFields(pubkey = pubkey, created_at = created_at,
        kind = 1, tags = "[]", content = content.borrowed_view())
    digest := crypto.sha256_str(nostril_serialized_event(fields))
    fields.id = digest.to_hex()
    fields.sig = crypto.schnorr_sign(U256.from_hex(secret_key), digest, nostril_random_u256())!.to_hex()
    return format("{\"id\":", json_quote(fields.id), ",\"pubkey\":",
        json_quote(fields.pubkey), ",\"created_at\":", fields.created_at.to_str(),
        ",\"kind\":1,\"tags\":[],\"content\":", json_quote(fields.content),
        ",\"sig\":", json_quote(fields.sig), "}")
}

/// Verify an event's canonical id and BIP-340 signature.
nostril_event_is_valid := proc(event_json: Str) returns Bool {
    mut fields := NostrEventFields()
    return nostril_parse_complete_event(event_json, fields) && nostril_valid_fields(fields)
}

/// Return content only from a valid event; invalid events produce an empty string.
nostril_event_content := proc(event_json: Str) returns Str {
    mut fields := NostrEventFields()
    if !nostril_parse_complete_event(event_json, fields) || !nostril_valid_fields(fields) { return "" }
    return fields.content.clone()
}

/// Verify a relay-to-client `["EVENT", subscription, event]` message.
nostril_relay_event_is_valid := proc(message: Str) returns Bool {
    mut fields := NostrEventFields()
    return nostril_parse_relay_event(message, fields) && nostril_valid_fields(fields)
}

/// Return content only from a valid relay EVENT; invalid messages are ignored.
nostril_relay_event_content := proc(message: Str) returns Str {
    mut fields := NostrEventFields()
    if !nostril_parse_relay_event(message, fields) || !nostril_valid_fields(fields) { return "" }
    return fields.content.clone()
}

/// Verified author identity for a relay EVENT, or empty for invalid input.
nostril_relay_event_pubkey := proc(message: Str) returns Str {
    mut fields := NostrEventFields()
    if !nostril_parse_relay_event(message, fields) || !nostril_valid_fields(fields) { return "" }
    return fields.pubkey.clone()
}

/// A verified event ID, or empty for invalid input.
nostril_event_id := proc(event_json: Str) returns Str {
    mut fields := NostrEventFields()
    if !nostril_parse_complete_event(event_json, fields) || !nostril_valid_fields(fields) { return "" }
    return fields.id.clone()
}

nostril_relay_event_id := proc(message: Str) returns Str {
    mut fields := NostrEventFields()
    if !nostril_parse_relay_event(message, fields) || !nostril_valid_fields(fields) { return "" }
    return fields.id.clone()
}

/// Local publication reply. Invalid events echo a well-formed claimed ID if
/// available; this does not validate that ID. An unparseable request uses "".
nostril_publication_reply := proc(event_json: Str, duplicate: Bool) returns Str {
    mut fields := NostrEventFields()
    parsed := nostril_parse_complete_event(event_json, fields)
    mut id := ""
    if nostril_is_lower_hex(fields.id, 64) { id = fields.id.clone() }
    if !parsed || !nostril_valid_fields(fields) {
        return format("[\"OK\",", json_quote(id), ",false,\"invalid: malformed event, id or signature\"]")
    }
    mut reason := ""
    if duplicate { reason = "duplicate: already accepted" }
    return format("[\"OK\",", json_quote(id), ",true,", json_quote(reason), "]")
}

/// Empty means malformed/unrelated reply. Only a matching, complete OK changes
/// publication state; no EVENT echo can acknowledge a publication.
nostril_publication_status := func(reply: Str, expected_id: Str) returns Str {
    mut cursor := JsonCursor(text = reply.borrowed_view())
    mut command := ""
    mut id := ""
    mut reason := ""
    if !json_take(cursor, '[') || !json_parse_string(cursor, command) || command != "OK" ||
        !json_take(cursor, ',') || !json_parse_string(cursor, id) || id != expected_id ||
        !json_take(cursor, ',') { return "" }
    json_skip_ws(cursor)
    rest := cursor.text.substr(cursor.at, cursor.text.len() - cursor.at)
    mut accepted := false
    if rest.starts_with("true") { accepted = true; cursor.at = cursor.at + 4 }
    else if rest.starts_with("false") { cursor.at = cursor.at + 5 }
    else { return "" }
    if !json_take(cursor, ',') || !json_parse_string(cursor, reason) || !json_take(cursor, ']') { return "" }
    json_skip_ws(cursor)
    if cursor.at != cursor.text.len() { return "" }
    if accepted { return "accepted" }
    return format("rejected: ", reason)
}

// This bounded subscription dialect requires an explicit limit in each filter,
// with a total history budget <= 50. Limit never affects live event matching.
// Unknown fields are rejected rather than silently broadening a subscription.
priv subscription_tag_matches := func(tags: Str, name: Str, wanted: Str) returns Bool {
    mut cursor := JsonCursor(text = tags.borrowed_view())
    if !json_take(cursor, '[') { return false }
    while json_take(cursor, '[') {
        mut key := ""
        mut value := ""
        if !json_parse_string(cursor, key) { return false }
        if json_take(cursor, ',') {
            if !json_parse_string(cursor, value) { return false }
            if key == name && value == wanted { return true }
            while json_take(cursor, ',') {
                if !json_parse_string(cursor, value) { return false }
            }
        }
        if !json_take(cursor, ']') { return false }
        if !json_take(cursor, ',') { break }
    }
    return false
}

priv subscription_filter := func(mut cursor: JsonCursor, event: NostrEventFields,
        mut matches: Bool, mut limit: I64) returns Bool {
    if !json_take(cursor, '{') { return false }
    mut keys := Set(Str).new()
    matches = true
    mut limited := false
    while true {
        mut key := ""
        if !json_parse_string(cursor, key) || keys.has(key) || !json_take(cursor, ':') { return false }
        keys.add(own key.clone())
        if key == "limit" || key == "since" || key == "until" {
            mut number : I64 = 0
            if !json_parse_nonnegative_i64(cursor, number) { return false }
            if key == "limit" { if number > 50 { return false }; limit = number; limited = true }
            else if key == "since" { matches = matches && event.created_at >= number }
            else { matches = matches && event.created_at <= number }
        } else {
            mut tag := false
            if key.len() == 2 && key[0] == '#' {
                byte := key[1].clone()
                tag = (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')
            }
            if key != "ids" && key != "authors" && key != "kinds" && !tag { return false }
            if !json_take(cursor, '[') { return false }
            mut any_match := false
            while true {
                if key == "kinds" {
                    mut kind : I64 = 0
                    if !json_parse_nonnegative_i64(cursor, kind) || kind > 65535 { return false }
                    any_match = any_match || kind == event.kind
                } else {
                    mut value := ""
                    if !json_parse_string(cursor, value) { return false }
                    if (!tag || key == "#e" || key == "#p") && !nostril_is_lower_hex(value, 64) { return false }
                    if key == "ids" { any_match = any_match || value == event.id }
                    else if key == "authors" { any_match = any_match || value == event.pubkey }
                    else { any_match = any_match || subscription_tag_matches(event.tags, key.substr(1, 1), value) }
                }
                if json_take(cursor, ']') { break }
                if !json_take(cursor, ',') { return false }
            }
            matches = matches && any_match
        }
        if json_take(cursor, '}') { break }
        if !json_take(cursor, ',') { return false }
    }
    return limited
}

priv subscription_parse := func(message: Str, event: NostrEventFields,
        mut id: Str, mut matches: Bool, mut history_limit: I64) returns Bool {
    mut cursor := JsonCursor(text = message.borrowed_view())
    mut command := ""
    if !json_take(cursor, '[') || !json_parse_string(cursor, command) || command != "REQ" ||
        !json_take(cursor, ',') || !json_parse_string(cursor, id) ||
        id.len() == 0 || nostril_utf8_scalars(id) > 64 || !json_take(cursor, ',') { return false }
    matches = false
    history_limit = 0
    while true {
        mut filter_matches := false
        mut limit : I64 = 0
        if !subscription_filter(cursor, event, filter_matches, limit) { return false }
        history_limit = history_limit + limit
        if history_limit > 50 { return false }
        matches = matches || filter_matches
        if json_take(cursor, ']') { break }
        if !json_take(cursor, ',') { return false }
    }
    json_skip_ws(cursor)
    return cursor.at == cursor.text.len()
}

/// Validated bounded REQ ID, or empty for an unsupported/malformed request.
nostril_subscription_id := func(message: Str) returns Str {
    mut id := ""
    mut matches := false
    empty := NostrEventFields()
    mut limit : I64 = 0
    if !subscription_parse(message, empty, id, matches, limit) { return "" }
    return id
}

/// Sum of per-filter history limits (0..50), or -1 for an invalid request.
nostril_subscription_limit := func(request: Str) returns I64 {
    mut id := ""
    mut matches := false
    mut limit : I64 = 0
    empty := NostrEventFields()
    if !subscription_parse(request, empty, id, matches, limit) { return -1 }
    return limit
}

/// An independent single-filter REQ for history selection; empty at end/error.
nostril_subscription_filter_at := func(request: Str, index: I64) returns Str {
    id := nostril_subscription_id(request)
    if id.len() == 0 || index < 0 { return "" }
    mut cursor := JsonCursor(text = request.borrowed_view())
    mut value := ""
    if !json_take(cursor, '[') || !json_parse_string(cursor, value) ||
        !json_take(cursor, ',') || !json_parse_string(cursor, value) { return "" }
    mut at : I64 = 0
    empty := NostrEventFields()
    while json_take(cursor, ',') {
        start := cursor.at
        mut matches := false
        mut limit : I64 = 0
        if !subscription_filter(cursor, empty, matches, limit) { return "" }
        if at == index { return format("[\"REQ\",", json_quote(id), ",", request.substr(start, cursor.at - start), "]") }
        at++
    }
    return ""
}

// Ordering helpers for already-verified events. Parsing here does not authenticate
// an event; callers must validate before insertion. Ascending storage order puts
// newest timestamps (and lowest IDs on ties) at the end, as the GUI expects.
priv nostril_fields_before := func(left: NostrEventFields, right: NostrEventFields) returns Bool {
    return left.created_at < right.created_at ||
        (left.created_at == right.created_at && left.id > right.id)
}
nostril_event_before := func(left: Str, right: Str) returns Bool {
    mut a := NostrEventFields(); mut b := NostrEventFields()
    return nostril_parse_complete_event(left, a) && nostril_parse_complete_event(right, b) && nostril_fields_before(a, b)
}
nostril_relay_event_before := func(left: Str, right: Str) returns Bool {
    mut a := NostrEventFields(); mut b := NostrEventFields()
    return nostril_parse_relay_event(left, a) && nostril_parse_relay_event(right, b) && nostril_fields_before(a, b)
}

/// REQ prefix ID for rejection routing; CLOSE must be a complete message.
nostril_control_id := func(message: Str, wanted: Str) returns Str {
    mut cursor := JsonCursor(text = message.borrowed_view())
    mut command := ""
    mut id := ""
    if !json_take(cursor, '[') || !json_parse_string(cursor, command) || command != wanted ||
        !json_take(cursor, ',') || !json_parse_string(cursor, id) ||
        id.len() == 0 || nostril_utf8_scalars(id) > 64 { return "" }
    if wanted == "CLOSE" {
        if !json_take(cursor, ']') { return "" }
        json_skip_ws(cursor)
        if cursor.at != cursor.text.len() { return "" }
    }
    return id
}

nostril_subscription_matches := proc(request: Str, event_json: Str) returns Bool {
    mut fields := NostrEventFields()
    if !nostril_parse_complete_event(event_json, fields) || !nostril_valid_fields(fields) { return false }
    mut id := ""
    mut matches := false
    mut limit : I64 = 0
    return subscription_parse(request, fields, id, matches, limit) && matches
}

nostril_subscription_matches_relay := proc(request: Str, message: Str) returns Bool {
    mut fields := NostrEventFields()
    if !nostril_parse_relay_event(message, fields) || !nostril_valid_fields(fields) { return false }
    mut id := ""
    mut matches := false
    mut limit : I64 = 0
    return subscription_parse(request, fields, id, matches, limit) && matches
}

nostril_subscription_response := func(request: Str) returns Str {
    id := nostril_subscription_id(request)
    if id.len() > 0 { return format("[\"EOSE\",", json_quote(id), "]") }
    rejected := nostril_control_id(request, "REQ")
    if rejected.len() > 0 {
        return format("[\"CLOSED\",", json_quote(rejected), ",\"unsupported: filters require explicit limits totaling at most 50\"]")
    }
    return "[\"NOTICE\",\"invalid: expected bounded REQ or CLOSE\"]"
}

nostril_subscription_envelope := func(id: Str, event_json: Str) returns Str {
    return format("[\"EVENT\",", json_quote(id), ",", event_json, "]")
}

/// Parse complete relay control messages. Unknown or malformed messages do not
/// change connection/subscription state; only this subscription's EOSE/CLOSED do.
nostril_relay_control := func(message: Str, subscription: Str) returns Str {
    mut cursor := JsonCursor(text = message.borrowed_view())
    mut command := ""
    mut value := ""
    if !json_take(cursor, '[') || !json_parse_string(cursor, command) ||
        !json_take(cursor, ',') || !json_parse_string(cursor, value) { return "" }
    mut result := ""
    if command == "NOTICE" { result = format("notice: ", value) }
    else if command == "EOSE" && value == subscription { result = "eose" }
    else if command == "CLOSED" && value == subscription {
        mut reason := ""
        if !json_take(cursor, ',') || !json_parse_string(cursor, reason) { return "" }
        result = format("closed: ", reason)
    } else { return "" }
    if !json_take(cursor, ']') { return "" }
    json_skip_ws(cursor)
    if cursor.at != cursor.text.len() { return "" }
    return result
}

nostril_key_encoding := func(key: Str) returns Bool { return nostril_is_lower_hex(key, 64) }

nostril_secret_valid := func(key: Str) returns Bool {
    if !nostril_is_lower_hex(key, 64) { return false }
    value := U256.from_hex(key)
    zero := U256()
    order := U256.from_hex("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141")
    return U256.cmp(value, zero) > 0 && U256.cmp(value, order) < 0
}

// Read p-tag public keys while retaining complete original tags for updates.
priv follow_tags := func(tags: Str, mut keys: Vec(Str), target: Str, remove: Bool,
        rename: Bool = false, petname: Str = "") returns Str {
    mut cursor := JsonCursor(text = tags.borrowed_view())
    if !json_take(cursor, '[') { return "" }
    mut out := Str.with_capacity(tags.len() + 80)
    out.push_str("[")
    mut first := true
    if !json_take(cursor, ']') {
        while true {
            json_skip_ws(cursor)
            start := cursor.at
            if !json_take(cursor, '[') { return "" }
            mut name := ""
            mut value := ""
            mut relay_hint := ""
            mut trailing := ""
            if !json_parse_string(cursor, name) { return "" }
            if json_take(cursor, ',') {
                if !json_parse_string(cursor, value) { return "" }
                mut position : I64 = 2
                while json_take(cursor, ',') {
                    mut extra := ""
                    if !json_parse_string(cursor, extra) { return "" }
                    if position == 2 { relay_hint = extra.clone() }
                    else if position >= 4 { trailing = format(trailing, ",", json_quote(extra)) }
                    position++
                }
            }
            if !json_take(cursor, ']') { return "" }
            if name == "p" {
                if !nostril_key_encoding(value) { return "" }
                if !(remove && value == target) { keys.push(own value.clone()) }
            }
            if !(remove && name == "p" && value == target) {
                if !first { out.push_str(",") }
                if rename && name == "p" && value == target {
                    out.push_str(format("[\"p\",", json_quote(value), ",", json_quote(relay_hint),
                        ",", json_quote(petname), trailing, "]"))
                } else { out.push_str(tags.substr(start, cursor.at - start)) }
                first = false
            }
            if json_take(cursor, ']') { break }
            if !json_take(cursor, ',') { return "" }
        }
    }
    if target.len() > 0 && !remove && !rename {
        mut found := false
        for key : Str in keys { if key == target { found = true } }
        if !found {
            if !first { out.push_str(",") }
            out.push_str(format("[\"p\",", json_quote(target), "]"))
            keys.push(own target.clone())
        }
    }
    out.push_str("]")
    return out
}

nostril_follows_valid := proc(event: Str, owner: Str) returns Bool {
    mut fields := NostrEventFields()
    if !nostril_parse_complete_event(event, fields) || fields.kind != 3 ||
        fields.pubkey != owner || !nostril_valid_fields(fields) { return false }
    mut keys := Vec(Str).new()
    return follow_tags(fields.tags, keys, "", false).len() > 0 && keys.len() <= 512
}

nostril_follows_keys := proc(event: Str, owner: Str) returns Str {
    mut fields := NostrEventFields()
    if !nostril_parse_complete_event(event, fields) || fields.kind != 3 ||
        fields.pubkey != owner || !nostril_valid_fields(fields) { return "" }
    mut keys := Vec(Str).new()
    tags := follow_tags(fields.tags, keys, "", false)
    if tags.len() == 0 || keys.len() > 512 { return "" }
    mut out := ""
    for key : Str in keys { out = format(out, key, "\n") }
    return out
}

/// Empty clears a petname; nonempty names follow NIP-02's resolution spelling.
nostril_petname_valid := func(name: Str) returns Bool {
    if name.len() > 64 { return false }
    for byte : I8 in name {
        if !((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') ||
                (byte >= '0' && byte <= '9') || byte == '_') { return false }
    }
    return true
}

priv FollowName := struct { pubkey := ""; petname := "" }

// Called only on validated follow tags; preserve all tags elsewhere for edits.
priv follow_names := func(tags: Str) returns Vec(FollowName) {
    mut entries := Vec(FollowName).new()
    mut cursor := JsonCursor(text = tags.borrowed_view())
    if !json_take(cursor, '[') { return entries }
    while json_take(cursor, '[') {
        mut values := Vec(Str).new()
        mut value := ""
        while json_parse_string(cursor, value) {
            values.push(own value.clone())
            if !json_take(cursor, ',') { break }
        }
        if !json_take(cursor, ']') { return entries }
        if values.len() >= 2 && values[0] == "p" {
            mut name := ""
            if values.len() >= 4 { name = values[3].clone() }
            entries.push(own FollowName(pubkey = values[1].clone(), petname = name.clone()))
        }
        if !json_take(cursor, ',') { break }
    }
    return entries
}

/// Owned key->petname snapshot. Invalid, duplicate-name or conflicting-key
/// aliases are omitted, never arbitrarily resolved to one identity.
nostril_follows_petnames := proc(event: Str, owner: Str) returns Map(Str, Str) {
    mut result := Map(Str, Str).new()
    if !nostril_follows_valid(event, owner) { return result }
    mut fields := NostrEventFields()
    nostril_parse_complete_event(event, fields)
    entries := follow_names(fields.tags)
    mut owners := Map(Str, Str).new()
    mut names := Map(Str, Str).new()
    for entry : FollowName in entries {
        if names.has(entry.pubkey) {
            if names[entry.pubkey] != entry.petname { names.set(entry.pubkey, own Str.with_capacity(0)) }
        } else { names.set(entry.pubkey, own entry.petname.clone()) }
        if entry.petname.len() == 0 || !nostril_petname_valid(entry.petname) { continue }
        if owners.has(entry.petname) {
            if owners[entry.petname] != entry.pubkey { owners.set(entry.petname, own Str.with_capacity(0)) }
        } else { owners.set(entry.petname, own entry.pubkey.clone()) }
    }
    for entry : FollowName in entries {
        if entry.petname.len() > 0 && names[entry.pubkey] == entry.petname &&
                owners.has(entry.petname) && owners[entry.petname] == entry.pubkey {
            result.set(entry.pubkey, own entry.petname.clone())
        }
    }
    return result
}

nostril_follows_petname := proc(event: Str, owner: Str, target: Str) returns Str {
    names := nostril_follows_petnames(event, owner)
    if names.has(target) { return names[target].clone() }
    return ""
}

priv update_follow_event := proc(secret: Str, previous: Str, target: Str, remove: Bool,
        timestamp: I64, rename: Bool, petname: Str) returns Str {
    if !nostril_secret_valid(secret) || !nostril_key_encoding(target) { return "" }
    owner := nostril_pubkey(secret)
    mut fields := NostrEventFields(pubkey = owner.clone(), kind = 3, tags = "[]", created_at = timestamp)
    if previous.len() > 0 {
        if !nostril_follows_valid(previous, owner) { return "" }
        nostril_parse_complete_event(previous, fields)
        if fields.created_at == I64.MAX { return "" }
        if timestamp <= fields.created_at { fields.created_at++ }
        else { fields.created_at = timestamp }
    }
    mut keys := Vec(Str).new()
    tags := follow_tags(fields.tags, keys, target, remove, rename, petname)
    if tags.len() == 0 || keys.len() > 512 { return "" }
    fields.tags = tags.clone()
    digest := crypto.sha256_str(nostril_serialized_event(fields))
    signature := crypto.schnorr_sign(U256.from_hex(secret), digest, nostril_random_u256())!
    return format("{\"id\":", json_quote(digest.to_hex()), ",\"pubkey\":", json_quote(owner),
        ",\"created_at\":", fields.created_at.to_str(), ",\"kind\":3,\"tags\":", fields.tags,
        ",\"content\":", json_quote(fields.content), ",\"sig\":", json_quote(signature.to_hex()), "}")
}

nostril_update_follows := proc(secret: Str, previous: Str, target: Str, remove: Bool, timestamp: I64) returns Str {
    return update_follow_event(secret, previous, target, remove, timestamp, false, "")
}

/// Rename only an existing follow, rejecting aliases belonging to another key.
nostril_update_petname := proc(secret: Str, previous: Str, target: Str, name: Str, timestamp: I64) returns Str {
    if !nostril_secret_valid(secret) || !nostril_petname_valid(name) { return "" }
    owner := nostril_pubkey(secret)
    if !nostril_follows_valid(previous, owner) { return "" }
    mut fields := NostrEventFields()
    nostril_parse_complete_event(previous, fields)
    entries := follow_names(fields.tags)
    mut found := false
    for entry : FollowName in entries {
        if entry.pubkey == target { found = true }
        else if name.len() > 0 && entry.petname == name { return "" }
    }
    if !found { return "" }
    return update_follow_event(secret, previous, target, false, timestamp, true, name)
}
