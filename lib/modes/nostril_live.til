import("nostril_nng")

nostril_feed_receive := ext_proc(shallow socket_id: U32, mut buffer: Dynamic,
    shallow capacity: USize, mut size: USize, mut peer: U32) returns shallow I32 {}
nostril_feed_send := ext_proc(shallow socket_id: U32, shallow peer: U32,
    bytes: Dynamic, shallow size: USize) returns shallow I32 {}
nostril_feed_peer_alive := ext_proc(shallow peer: U32) returns shallow I32 {}

NOSTRIL_LIVE_ENDPOINT := "ipc://tmp/nostril-live.ipc"
NOSTRIL_LIVE_REQUEST := "[\"REQ\",\"local\",{\"kinds\":[1],\"limit\":0}]"

// Callers own the socket and close it before leaving the session.
nostril_live_open := proc(mut socket: nng_socket, endpoint: Str, listen: Bool,
        asynchronous: Bool = true) {
    if listen {
        nostril_nng_check(nng_pair1_open_poly(socket), "open routed feed")
        nostril_nng_check(nng_socket_set_int(socket, "send-buffer".c_str, 64), "buffer targeted feed sends")
        mut listener := nng_listener()
        nostril_nng_check(nng_listen(socket, endpoint.c_str, listener, 0), "listen on routed feed")
    } else {
        nostril_nng_check(nng_pair1_open(socket), "open feed client")
        nostril_nng_check(nng_socket_set_int(socket, "send-buffer".c_str, 64), "buffer subscription controls")
        mut dialer := nng_dialer()
        mut flags : I32 = 0
        if asynchronous { flags = 2 }
        nostril_nng_check(nng_dial(socket, endpoint.c_str, dialer, flags), "dial routed feed")
    }
}

nostril_feed_read := proc(socket: nng_socket, mut message: Str, mut peer: U32) returns Bool {
    message = ""
    peer = 0
    mut bytes := Str.with_capacity(NOSTRIL_NNG_MAX_MESSAGE)
    mut size : USize = 0
    rc := nostril_feed_receive(socket.id, bytes.c_str, NOSTRIL_NNG_MAX_MESSAGE, size, peer)
    if rc == 8 { return false }
    if rc == 17 { return true }
    nostril_nng_check(rc, "receive routed feed frame")
    if size == 0 || size > NOSTRIL_NNG_MAX_MESSAGE { return true }
    ref last : I8 = ptr_add(bytes.c_str, (size - 1).to_uptr())
    if last != 0 { return true }
    bytes.count = size - 1
    for byte : I8 in bytes { if byte == 0 { return true } }
    message = bytes.clone()
    return true
}

nostril_feed_write := proc(socket: nng_socket, peer: U32, message: Str) returns Bool {
    if message.len() + 1 > NOSTRIL_NNG_MAX_MESSAGE { return false }
    rc := nostril_feed_send(socket.id, peer, message.c_str, message.len() + 1)
    if rc == 8 { return false }
    nostril_nng_check(rc, "send targeted feed frame")
    return true
}

FeedClient := struct {
    peer : U32 = 0
    ready := false
    retry_at : U64 = 0
    request : Str = NOSTRIL_LIVE_REQUEST
}

nostril_feed_poll := proc(socket: nng_socket, mut client: FeedClient, mut timeline: Vec(Str)) {
    if client.peer != 0 && nostril_feed_peer_alive(client.peer) == 0 {
        client.peer = 0
        client.ready = false
        client.retry_at = 0
    }
    now := nng_clock()
    if !client.ready && now >= client.retry_at {
        nostril_live_send(socket, client.request)
        client.retry_at = now + 1000
    }
    mut message := ""
    mut peer : U32 = 0
    mut budget : I64 = 32
    while budget > 0 && nostril_feed_read(socket, message, peer) {
        if message == NOSTRIL_LOCAL_EOSE {
            client.peer = peer
            client.ready = true
        } else if client.ready && peer == client.peer && nostril_control_id(message, "EVENT") == "local" {
            if nostril_subscription_matches_relay(client.request, message) { nostril_live_accept(timeline, message) }
        }
        budget--
    }
}

// Nonblocking, bounded framing. An invalid frame is consumed with empty output.
nostril_live_receive := proc(socket: nng_socket, mut message: Str) returns Bool {
    message = ""
    mut buffer := Str.with_capacity(NOSTRIL_NNG_MAX_MESSAGE)
    mut size := NOSTRIL_NNG_MAX_MESSAGE
    status := nng_recv(socket, buffer.c_str, size, 2)
    if status == 8 { return false }
    if status == 17 { return true }
    nostril_nng_check(status, "receive live event")
    if size == 0 || size > NOSTRIL_NNG_MAX_MESSAGE { return true }
    ref last : I8 = ptr_add(buffer.c_str, (size - 1).to_uptr())
    if last != 0 { return true }
    buffer.count = size - 1
    for byte : I8 in buffer { if byte == 0 { return true } }
    message = buffer.clone()
    return true
}

nostril_live_send := proc(socket: nng_socket, message: Str) returns Bool {
    if message.len() + 1 > NOSTRIL_NNG_MAX_MESSAGE { return false }
    mut bytes := message.clone()
    status := nng_send(socket, bytes.c_str, bytes.len() + 1, 2)
    if status == 8 { return false }
    nostril_nng_check(status, "send live event")
    return true
}

nostril_live_envelope := func(event: Str) returns Str {
    return format("[\"EVENT\",\"local\",", event, "]")
}

// Shared by the GUI and integration tests. Invalid messages never enter state.
nostril_live_accept := proc(mut timeline: Vec(Str), message: Str) returns Bool {
    id := nostril_relay_event_id(message)
    if id.len() == 0 { return false }
    for saved : Str in timeline { if nostril_relay_event_id(saved) == id { return false } }
    timeline.push(own message.clone())
    return true
}

// One outstanding request per client socket; NNG retains and retransmits the
// original request after disconnect/reconnect or a lost reply.
nostril_publish_open := proc(mut socket: nng_socket, endpoint: Str, listen: Bool,
        asynchronous: Bool = true) {
    address := format(endpoint, ".publish")
    if listen {
        nostril_nng_check(nng_rep0_open(socket), "open publication replies")
        mut listener := nng_listener()
        nostril_nng_check(nng_listen(socket, address.c_str, listener, 0), "listen for publications")
    } else {
        nostril_nng_check(nng_req0_open(socket), "open publication requests")
        nostril_nng_check(nng_socket_set_ms(socket, "req:resend-time".c_str, 500), "set publication retry interval")
        mut dialer := nng_dialer()
        mut flags : I32 = 0
        if asynchronous { flags = 2 }
        nostril_nng_check(nng_dial(socket, address.c_str, dialer, flags), "dial publications")
    }
}

Publication := struct {
    event : Str = ""
    id : Str = ""
    status : Str = "pending"
    waiting := false
}

nostril_publish_queue := proc(mut outbox: Vec(Publication), event: Str) {
    id := nostril_event_id(event)
    if id.len() == 0 { panic("cannot queue an invalid local event") }
    for entry : Publication in outbox { if entry.id == id { return } }
    mut state := "pending"
    if nostril_live_envelope(event).len() + 1 > NOSTRIL_NNG_MAX_MESSAGE {
        state = "rejected: event exceeds local frame limit"
    }
    outbox.push(own Publication(event = event.clone(), id = id.clone(), status = state.clone()))
}

nostril_publish_poll := proc(socket: nng_socket, mut outbox: Vec(Publication)) {
    for mut entry : Publication in outbox {
        if entry.status != "pending" { continue }
        if !entry.waiting {
            entry.waiting = nostril_live_send(socket, entry.event)
            return
        }
        mut reply := ""
        if !nostril_live_receive(socket, reply) { return }
        status := nostril_publication_status(reply, entry.id)
        if status.len() > 0 { entry.status = status.clone() }
        // A malformed/mismatched reply consumed the NNG request. Resubmit the
        // unchanged event on the next poll, rather than accepting that reply.
        entry.waiting = false
        return
    }
}

nostril_publish_label := func(outbox: Vec(Publication), id: Str) returns Str {
    for entry : Publication in outbox { if entry.id == id { return entry.status.clone() } }
    return "received"
}

// Relay state is session-only. NNG REP routes each OK solely to the requester.
LiveRelay := struct {
    accepted := Set(Str).new()
    reply : Str = ""
    replying := false
    subscriptions := Vec(LiveSubscription).new()
    control_peer : U32 = 0
    control_request : Str = ""
    control_reply : Str = ""
}

LiveSubscription := struct {
    peer : U32 = 0
    id : Str = ""
    request : Str = ""
}

// Reverse indexing is necessary here: removals change the collection length.
nostril_subscription_remove := proc(mut state: LiveRelay, peer: U32, id: Str) {
    mut i := state.subscriptions.len()
    while i > 0 {
        i--
        ref sub : LiveSubscription = state.subscriptions[i]
        if (sub.peer == peer && sub.id == id) || nostril_feed_peer_alive(sub.peer) == 0 {
            state.subscriptions.remove_at(i)!
        }
    }
}

nostril_subscription_step := proc(socket: nng_socket, mut state: LiveRelay) returns Bool {
    nostril_subscription_remove(state, 0, "")
    if state.control_reply.len() > 0 { return nostril_subscription_flush(socket, state) }
    mut message := ""
    mut peer : U32 = 0
    if !nostril_feed_read(socket, message, peer) { return false }
    closed := nostril_control_id(message, "CLOSE")
    if closed.len() > 0 { nostril_subscription_remove(state, peer, closed); return true }
    requested := nostril_control_id(message, "REQ")
    // Replacement applies within this connection only, including a rejected REQ.
    if requested.len() > 0 { nostril_subscription_remove(state, peer, requested) }
    state.control_peer = peer
    state.control_request = message.clone()
    state.control_reply = nostril_subscription_response(message)
    nostril_subscription_flush(socket, state)
    return true
}

nostril_subscription_flush := proc(socket: nng_socket, mut state: LiveRelay) returns Bool {
    if nostril_feed_peer_alive(state.control_peer) != 0 {
        if !nostril_feed_write(socket, state.control_peer, state.control_reply) { return false }
        id := nostril_subscription_id(state.control_request)
        if id.len() > 0 {
            state.subscriptions.push(own LiveSubscription(peer = state.control_peer,
                id = id.clone(), request = state.control_request.clone()))
        }
    }
    state.control_reply = ""
    state.control_request = ""
    state.control_peer = 0
    return true
}

nostril_live_relay_step := proc(events: nng_socket, requests: nng_socket,
        mut state: LiveRelay) returns Bool {
    controlled := nostril_subscription_step(events, state)
    if state.replying {
        if nostril_live_send(requests, state.reply) {
            state.replying = false
            state.reply = ""
        }
        return true
    }
    mut event := ""
    if !nostril_live_receive(requests, event) { return controlled }
    id := nostril_event_id(event)
    mut duplicate := false
    if id.len() > 0 {
        duplicate = state.accepted.has(id)
        if !duplicate {
            envelope := nostril_live_envelope(event)
            if envelope.len() + 1 > NOSTRIL_NNG_MAX_MESSAGE {
                state.reply = format("[\"OK\",\"", id, "\",false,\"invalid: event exceeds local frame limit\"]")
                state.replying = true
                return true
            }
            for sub : LiveSubscription in state.subscriptions {
                if nostril_subscription_matches(sub.request, event) {
                    nostril_feed_write(events, sub.peer, nostril_subscription_envelope(sub.id, event))
                }
            }
            state.accepted.add(own id.clone())
        }
    }
    state.reply = nostril_publication_reply(event, duplicate)
    state.replying = true
    return true
}
