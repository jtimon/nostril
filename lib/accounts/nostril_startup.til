mode lib
import("../nostril/event")
import("../nostril/nip19")
import("std/sys")
import("std/file")
link_c("store.c")

nostril_store_directory := ext_proc(path: I8, shallow create: Bool) returns shallow I32 {}
nostril_store_lock := ext_proc(path: I8, mut error: I32) returns ref Dynamic {}
nostril_store_unlock := ext_proc(handle: Dynamic) {}
nostril_store_read := ext_proc(handle: Dynamic, name: I8, mut error: I32) returns Str {}
nostril_store_write := ext_proc(handle: Dynamic, name: I8, bytes: Str, shallow exclusive: Bool) returns shallow I32 {}

priv AccountSpec := struct { name : Str = ""; pubkey : Str = "" }
priv mut accounts := Vec(AccountSpec).new()
priv mut selected := ""
priv mut relay := ""
priv mut config_error := ""
priv mut active_secret := ""
priv mut active_pubkey := ""
priv mut active_name := ""
priv mut active_follows := ""
priv mut active_petnames := Map(Str, Str).new()
priv mut active_directory := ""

nostril_config_reset := proc() {
    noop_proc()
    accounts.clear(); selected = ""; relay = ""; config_error = ""
    active_secret = ""; active_pubkey = ""; active_name = ""; active_follows = ""; active_directory = ""
    active_petnames.clear()
}

nostril_config_account := proc(name: Str, pubkey: Str) {
    noop_proc()
    if name.len() == 0 || name.len() > 64 || !nostril_key_encoding(pubkey) {
        config_error = "account registration requires a name and a lowercase 64-digit public key"
        return
    }
    for account : AccountSpec in accounts {
        if account.name == name { config_error = "duplicate account name"; return }
    }
    accounts.push(own AccountSpec(name = name.clone(), pubkey = pubkey.clone()))
}

nostril_config_select := proc(name: Str) { noop_proc(); selected = name.clone() }
nostril_config_relay := proc(url: Str) { noop_proc(); relay = url.clone() }
nostril_account_relay := proc() returns Str { noop_proc(); return relay.clone() }
nostril_account_public_key := proc() returns Str { noop_proc(); return active_pubkey.clone() }
nostril_account_name := proc() returns Str { noop_proc(); return active_name.clone() }
nostril_account_persistent := proc() returns Bool { noop_proc(); return active_directory.len() > 0 }
nostril_account_follows := proc() returns Str { noop_proc(); return active_follows.clone() }
nostril_account_petname := proc(pubkey: Str) returns Str {
    noop_proc()
    if active_petnames.has(pubkey) { return active_petnames[pubkey].clone() }
    return ""
}
// A local label, never profile-supplied. The GUI displays the key alongside it.
nostril_account_author_label := proc(pubkey: Str) returns Str {
    name := nostril_account_petname(pubkey)
    if name.len() > 0 { return name }
    if pubkey == active_pubkey { return "You" }
    if nostril_key_encoding(pubkey) { return format(pubkey.substr(0, 8), "...", pubkey.substr(56, 8)) }
    return "Unknown"
}
nostril_account_count := proc() returns I64 { noop_proc(); return accounts.len().to_i64() }
nostril_account_name_at := proc(index: I64) returns Str {
    noop_proc()
    if index < 0 || index >= accounts.len().to_i64() { return "" }
    return accounts[index.to_usize()].name.clone()
}

// Host operation: keep both selection and active identity on a failed switch.
// Configuration registration stays intact; init need not be evaluated again.
nostril_account_switch := proc(root: Str, name: Str) returns Str {
    mut found := false
    for account : AccountSpec in accounts { if account.name == name { found = true } }
    if !found { return "select a registered account" }
    previous := selected.clone()
    selected = name.clone()
    error := nostril_config_apply(root)
    if error.len() > 0 { selected = previous.clone() }
    return error
}

priv storage_error := func(operation: Str, error: I32) returns Str {
    return format(operation, " failed (storage error ", error.to_str(), ")")
}

priv account_tree := proc(root: Str, pubkey: Str, create: Bool) returns Str {
    if root.len() == 0 { return "persistent accounts need an absolute XDG_CONFIG_HOME or HOME" }
    // The shared XDG parent may not exist yet and need not be owner-only.
    // The application directory and account subtree are checked below.
    slash := root.rfind("/")
    if create && slash > 0 {
        error := mkdir_p(root.substr(0, slash.to_usize()))
        if error != 0 { return storage_error("configuration parent directory", error) }
    }
    for path : Str in array(Str, root, format(root, "/accounts"), format(root, "/accounts/", pubkey)) {
        value := path.clone()
        error := nostril_store_directory(value.c_str, create)
        if error != 0 { return storage_error("account directory (must be owner-only)", error) }
    }
    return ""
}

nostril_account_create := proc(root: Str) returns Str {
    secret := nostril_generate_secret_key()
    pubkey := nostril_pubkey(secret)
    error := account_tree(root, pubkey, true)
    if error.len() > 0 { return error }
    directory := format(root, "/accounts/", pubkey)
    mut code : I32 = 0
    ref handle : Dynamic = nostril_store_lock(directory.c_str, code)
    if handle.is_null() { return storage_error("account lock", code) }
    bytes := format(secret, "\n")
    code = nostril_store_write(handle, "secret.key".c_str, bytes, true)
    nostril_store_unlock(handle)
    if code != 0 { return storage_error("create secret key", code) }
    return pubkey
}

priv catalog_name_valid := func(name: Str) returns Bool {
    if name.len() == 0 || name.len() > 64 || name != name.trim() || !nostril_valid_utf8(name) { return false }
    for byte : I8 in name { if byte.cast(U8) < 32 || byte.cast(U8) == 127 { return false } }
    return true
}

// Private versioned metadata, not executable Til. All catalog operations hold
// accounts/.lock, including read-modify-write for concurrent creators.
priv read_catalog := proc(handle: Dynamic, mut entries: Vec(AccountSpec)) returns Str {
    mut code : I32 = 0
    bytes := nostril_store_read(handle, "catalog.tsv".c_str, code)
    if code == -1 { return "" }
    if code != 0 { return storage_error("read account catalog", code) }
    if !bytes.starts_with("nostril-accounts-v1\n") || !bytes.ends_with("\n") { return "invalid account catalog" }
    lines := bytes.split("\n")
    // Skip the format header and terminal empty line; row order is the default.
    for index in 1..(lines.len() - 1) {
        fields := lines[index].split("\t")
        if fields.len() != 2 || !nostril_key_encoding(fields[0]) || !catalog_name_valid(fields[1]) {
            return "invalid account catalog entry"
        }
        for entry : AccountSpec in entries {
            if entry.name == fields[1] || entry.pubkey == fields[0] { return "duplicate account catalog entry" }
        }
        if entries.len() >= 256 { return "account catalog limit is 256" }
        entries.push(own AccountSpec(name = fields[1].clone(), pubkey = fields[0].clone()))
    }
    return ""
}

/// Merge durable GUI registrations with init declarations. Identical pairs
/// coalesce; a name bound to different keys is an error, never an override.
nostril_accounts_load := proc(root: Str) returns Str {
    if root.len() == 0 || !File.exists(format(root, "/accounts")) { return "" }
    for path : Str in array(Str, root, format(root, "/accounts")) {
        error := nostril_store_directory(path.c_str, false)
        if error != 0 { return storage_error("account catalog directory (must be owner-only)", error) }
    }
    mut code : I32 = 0
    directory := format(root, "/accounts")
    ref handle : Dynamic = nostril_store_lock(directory.c_str, code)
    if handle.is_null() { return storage_error("account catalog lock", code) }
    mut entries := Vec(AccountSpec).new()
    error := read_catalog(handle, entries)
    nostril_store_unlock(handle)
    if error.len() > 0 { return error }
    for entry : AccountSpec in entries {
        for account : AccountSpec in accounts {
            if account.name == entry.name && account.pubkey != entry.pubkey { return "account catalog name conflicts with init: choose a different local name" }
        }
    }
    initial := accounts.len() == 0 && selected.len() == 0
    for entry : AccountSpec in entries {
        mut exists := false
        for account : AccountSpec in accounts { if account.name == entry.name { exists = true } }
        if !exists { accounts.push(own entry.clone()) }
    }
    if initial && entries.len() > 0 { selected = entries[0].name.clone() }
    return ""
}

/// Returns a public hex key on success, otherwise an owned diagnostic. Complete
/// registration is published only after the secret and catalog are durable.
nostril_account_create_named := proc(root: Str, name: Str) returns Str {
    if !catalog_name_valid(name) { return "Use a local name of 1..64 UTF-8 bytes, without surrounding whitespace or ASCII control characters." }
    for account : AccountSpec in accounts { if account.name == name { return "An account with this local name already exists." } }
    // Create/check only the shared private directory before taking its lock.
    if root.len() == 0 { return "persistent accounts need an absolute XDG_CONFIG_HOME or HOME" }
    slash := root.rfind("/")
    if slash > 0 {
        code := mkdir_p(root.substr(0, slash.to_usize()))
        if code != 0 { return storage_error("configuration parent directory", code) }
    }
    directory := format(root, "/accounts")
    for path : Str in array(Str, root, directory) {
        error := nostril_store_directory(path.c_str, true)
        if error != 0 { return storage_error("account catalog directory (must be owner-only)", error) }
    }
    mut code : I32 = 0
    ref handle : Dynamic = nostril_store_lock(directory.c_str, code)
    if handle.is_null() { return storage_error("account catalog lock", code) }
    mut entries := Vec(AccountSpec).new()
    error := read_catalog(handle, entries)
    if error.len() > 0 { nostril_store_unlock(handle); return error }
    for entry : AccountSpec in entries {
        if entry.name == name { nostril_store_unlock(handle); return "An account with this local name already exists." }
    }
    if entries.len() >= 256 { nostril_store_unlock(handle); return "account catalog limit is 256" }
    pubkey := nostril_account_create(root)
    if !nostril_key_encoding(pubkey) { nostril_store_unlock(handle); return pubkey }
    entries.push(own AccountSpec(name = name.clone(), pubkey = pubkey.clone()))
    mut bytes := "nostril-accounts-v1\n"
    for entry : AccountSpec in entries { bytes = format(bytes, entry.pubkey, "\t", entry.name, "\n") }
    code = nostril_store_write(handle, "catalog.tsv".c_str, bytes, false)
    nostril_store_unlock(handle)
    if code != 0 { return format(storage_error("save account catalog", code), "; generated key retained at accounts/", pubkey, "/secret.key") }
    accounts.push(own AccountSpec(name = name.clone(), pubkey = pubkey.clone()))
    return pubkey
}

priv read_follows := proc(handle: Dynamic, pubkey: Str, mut event: Str) returns Str {
    mut code : I32 = 0
    data := nostril_store_read(handle, "follows.json".c_str, code)
    if code == -1 { event = ""; return "" }
    if code != 0 { return storage_error("read follow list", code) }
    if !nostril_follows_valid(data, pubkey) { return "invalid follow list: expected this account's signed kind-3 event (at most 512 p tags)" }
    event = data.clone()
    return ""
}

nostril_config_apply := proc(root: Str) returns Str {
    noop_proc()
    if config_error.len() > 0 { return config_error.clone() }
    if relay.len() > 0 && !relay.starts_with("wss://") && !relay.starts_with("ws://") &&
        !relay.starts_with("ipc://") && !relay.starts_with("inproc://") { return "unsupported relay URL" }
    if selected.len() == 0 && accounts.len() == 0 {
        active_secret = nostril_generate_secret_key()
        active_pubkey = nostril_pubkey(active_secret)
        active_name = "ephemeral"
        active_follows = ""
        active_petnames.clear()
        active_directory = ""
        return ""
    }
    mut pubkey := ""
    for account : AccountSpec in accounts { if account.name == selected { pubkey = account.pubkey.clone() } }
    if pubkey.len() == 0 { return "select a registered account with nostril_config_select" }
    directory_error := account_tree(root, pubkey, false)
    if directory_error.len() > 0 { return directory_error }
    directory := format(root, "/accounts/", pubkey)
    mut code : I32 = 0
    ref handle : Dynamic = nostril_store_lock(directory.c_str, code)
    if handle.is_null() { return storage_error("account lock", code) }
    bytes := nostril_store_read(handle, "secret.key".c_str, code)
    if code != 0 { nostril_store_unlock(handle); return storage_error("read secret key", code) }
    secret := bytes.trim().clone()
    if !nostril_secret_valid(secret) { nostril_store_unlock(handle); return "invalid secret key encoding or scalar" }
    if nostril_pubkey(secret) != pubkey { nostril_store_unlock(handle); return "secret key does not match the registered public key" }
    mut event := ""
    follow_error := read_follows(handle, pubkey, event)
    nostril_store_unlock(handle)
    if follow_error.len() > 0 { return follow_error }
    // Adopt only after the entire account has been validated.
    active_secret = secret.clone(); active_pubkey = pubkey.clone()
    active_name = selected.clone(); active_directory = directory.clone()
    active_follows = ""
    if event.len() > 0 { active_follows = nostril_follows_keys(event, pubkey) }
    active_petnames = nostril_follows_petnames(event, pubkey)
    return ""
}

nostril_account_sign := proc(content: Str, timestamp: I64) returns Str {
    if active_secret.len() == 0 { panic("no active account") }
    return nostril_sign_text_note(active_secret, content, timestamp)
}

priv edit_follow := proc(pubkey: Str, remove: Bool, rename: Bool, name: Str) returns Str {
    if active_directory.len() == 0 { return "select a persistent account before editing follows" }
    if !nostril_key_encoding(pubkey) { return "follow target must be a lowercase 64-digit public key" }
    if rename && !nostril_petname_valid(name) { return "Petnames use up to 64 ASCII letters, digits or underscore; empty clears." }
    mut code : I32 = 0
    ref handle : Dynamic = nostril_store_lock(active_directory.c_str, code)
    if handle.is_null() { return storage_error("follow-list lock", code) }
    mut previous := ""
    error := read_follows(handle, active_pubkey, previous)
    if error.len() > 0 { nostril_store_unlock(handle); return error }
    mut event := ""
    if rename { event = nostril_update_petname(active_secret, previous, pubkey, name, nostril_now()) }
    else { event = nostril_update_follows(active_secret, previous, pubkey, remove, nostril_now()) }
    if event.len() == 0 {
        nostril_store_unlock(handle)
        if rename { return "Cannot save petname: follow must exist and name must be unique in this account." }
        return "cannot update follow list (limit 512 or invalid previous state)"
    }
    code = nostril_store_write(handle, "follows.json".c_str, event, false)
    nostril_store_unlock(handle)
    if code != 0 { return storage_error("write follow list", code) }
    active_follows = nostril_follows_keys(event, active_pubkey)
    active_petnames = nostril_follows_petnames(event, active_pubkey)
    return ""
}

nostril_account_follow := proc(pubkey: Str, remove: Bool) returns Str {
    key := nostril_public_key_hex(pubkey)
    if key.len() == 0 { return "Use a hex public key, npub, nprofile or nostr: URI with a valid checksum." }
    return edit_follow(key, remove, false, "")
}
nostril_account_set_petname := proc(pubkey: Str, name: Str) returns Str {
    return edit_follow(pubkey, false, true, name)
}

nostril_account_subscription := proc() returns Str {
    noop_proc()
    if active_pubkey.len() == 0 { panic("no active account") }
    mut authors := Set(Str).new()
    authors.add(own active_pubkey.clone())
    for pubkey : Str in active_follows.split("\n") { if pubkey.len() > 0 { authors.add(own pubkey.clone()) } }
    mut out := "[\"REQ\",\"local\",{\"kinds\":[1],\"limit\":50,\"authors\":["
    mut first := true
    for author : Str in authors {
        if !first { out = format(out, ",") }
        out = format(out, "\"", author, "\"")
        first = false
    }
    return format(out, "]}]")
}
