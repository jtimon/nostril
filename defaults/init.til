mode lib

// Copy to $XDG_CONFIG_HOME/nostril/init.til (default ~/.config/nostril/init.til).
// Nostril supplies its API as a host prelude. User helper imports are relative
// to this file. Nostril interprets init() in-process before opening its window.
init := proc() {
    nostril_config_relay("")
    // Create an account with bin/nostril-gui --create-account, then use its
    // printed public key here. Secret keys never belong in this init file.
    // nostril_config_account("main", "<64 lowercase hex public key>")
    // nostril_config_select("main")
    // nostril_config_relay("wss://relay.damus.io")
}
