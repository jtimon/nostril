mode lib

// Copy to $XDG_CONFIG_HOME/nostril/init.til (default ~/.config/nostril/init.til).
// Nostril supplies its API as a host prelude. User helper imports are relative
// to this file. Nostril interprets init() in-process before opening its window.
init := proc() {
    nostril_config_relay("")
    // The GUI's Account -> New account saves named accounts automatically.
    // Or use bin/nostril-gui --create-account and register its printed key here.
    // Secret keys never belong in this init file.
    // nostril_config_account("main", "<64 lowercase hex public key>")
    // nostril_config_select("main")
    // The picker combines these registrations with GUI-created accounts.
    // Selection above is the initial account on each launch, including a
    // GUI-created name. Without init declarations/selection, the first saved
    // GUI account is selected automatically.
    // nostril_config_relay("wss://relay.damus.io")
}
