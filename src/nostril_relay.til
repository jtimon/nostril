mode nostril_relay

import("../lib/modes/nostril_live")
import("std/sys")
link_c("relay_signal.c")

nostril_relay_signals := ext_proc() returns shallow I32 {}
nostril_relay_running := ext_proc() returns shallow I32 {}

main := proc(args: ..Str) {
    if args.len() == 1 && (args[0] == "-v" || args[0] == "--version") {
        println(nostril_version())
        return
    }
    if args.len() > 0 && args[0] == "--live" {
        if args.len() > 2 { panic("usage: nostril-relay --live [ipc-endpoint]") }
        mut live_endpoint := NOSTRIL_LIVE_ENDPOINT
        if args.len() == 2 { live_endpoint = args[1].clone() }
        mkdir_p("tmp")
        mut live_socket := nng_socket()
        nostril_live_open(live_socket, live_endpoint, true)
        mut requests := nng_socket()
        nostril_publish_open(requests, live_endpoint, true)
        mut relay_state := LiveRelay()
        if nostril_relay_signals() != 0 { panic("cannot install relay signal handlers") }
        println("nostril-relay live feed on ", live_endpoint)
        while nostril_relay_running() != 0 {
            // Publications use the per-client reply path. Ignore old bus
            // publications so an unacknowledged path cannot bypass dedup.
            mut ignored := ""
            nostril_live_receive(live_socket, ignored)
            if !nostril_live_relay_step(live_socket, requests, relay_state) { sleep_ms(5) }
        }
        nostril_nng_close(requests)
        nostril_nng_close(live_socket)
        return
    }
    if args.len() > 1 { panic("usage: nostril-relay [ipc-endpoint] | --live [ipc-endpoint]") }
    mut endpoint := NOSTRIL_LOCAL_ENDPOINT
    if args.len() == 1 { endpoint = args[0].clone() }

    mut socket := nng_socket(id = 0)
    nostril_nng_check(nng_pair0_open(socket), "open relay socket")
    nostril_nng_configure(socket)
    mut listener := nng_listener(id = 0)
    nostril_nng_check(nng_listen(socket, endpoint.c_str, listener, 0), "listen")
    println("nostril-relay listening on ", endpoint)

    request := nostril_nng_receive(socket)
    if request != NOSTRIL_LOCAL_REQUEST {
        nostril_nng_close(socket)
        panic("expected local NIP-01 request, received: ", request)
    }
    println("received: ", request)

    // limit:0 returns no stored events, but NIP-01 still starts the live phase.
    nostril_nng_send(socket, NOSTRIL_LOCAL_EOSE)
    close := nostril_nng_receive(socket)
    if close != NOSTRIL_LOCAL_CLOSE {
        nostril_nng_close(socket)
        panic("expected local NIP-01 close, received: ", close)
    }
    println("received: ", close)
    nostril_nng_close(socket)
}
