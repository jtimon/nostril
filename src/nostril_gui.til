mode gui

import("../gen/nostril_api")
import("account_feed")
import("nostril_init")
import("config_paths")
import("text_input")

gui_status_text := func(text: Str) returns Str {
    return text_status_prefix(text, 160)
}

gui_fitting_tail := proc(text: Str, width: I32, font_size: I32) returns Str {
    mut visible := text.clone()
    mut start : USize = 0
    while visible.len() > 0 && MeasureText(visible.c_str, font_size) > width {
        start = grapheme_next(text, start)
        visible = text.substr(start, text.len() - start).clone()
    }
    return visible
}

gui_fitting_head := proc(text: Str, width: I32, font_size: I32) returns Str {
    if MeasureText(text.c_str, font_size) <= width { return text.clone() }
    mut visible := text.clone()
    while visible.len() > 0 {
        visible = text_without_last_grapheme(visible)
        candidate := format(visible, "...")
        if MeasureText(candidate.c_str, font_size) <= width { return candidate }
    }
    return ""
}

gui_wrapped_lines := proc(text: Str, width: I32, font_size: I32) returns I32 {
    mut count : I32 = 1
    mut line := ""
    for word : Str in text.split(" ") {
        mut candidate := word.clone()
        if line.len() > 0 { candidate = format(line, " ", word) }
        if line.len() > 0 && MeasureText(candidate.c_str, font_size) > width {
            count++
            line = word.clone()
        } else {
            line = candidate
        }
    }
    return count
}

gui_draw_wrapped := proc(text: Str, x: I32, y: I32, width: I32, font_size: I32,
        line_height: I32, color: Color) {
    mut line := ""
    mut row : I32 = 0
    for word : Str in text.split(" ") {
        mut candidate := word.clone()
        if line.len() > 0 { candidate = format(line, " ", word) }
        if line.len() > 0 && MeasureText(candidate.c_str, font_size) > width {
            DrawText(line.c_str, x, y + row * line_height, font_size, color)
            row++
            line = word.clone()
        } else {
            line = candidate
        }
    }
    DrawText(line.c_str, x, y + row * line_height, font_size, color)
}

gui_hit := proc(x: I32, y: I32, width: I32, height: I32) returns Bool {
    mouse := GetMousePosition()
    return mouse.x >= x.to_f32() && mouse.x < (x + width).to_f32() &&
        mouse.y >= y.to_f32() && mouse.y < (y + height).to_f32()
}

main := proc(args: ..Str) {
    if args.len() == 1 && (args[0] == "-v" || args[0] == "--version") {
        println(nostril_version())
        return
    }
    root := user_config_directory("nostril")
    if args.len() == 1 && args[0] == "--create-account" {
        result := nostril_account_create(root)
        if !nostril_key_encoding(result) { panic(result) }
        println(result)
        return
    }
    mut follow_action := false
    if args.len() > 0 {
        follow_action = args.len() == 2 && (args[0] == "--follow" || args[0] == "--unfollow")
        if !follow_action && (args[0] != "--relay" || args.len() > 2) {
            panic("usage: nostril-gui [--version | --relay [endpoint] | --create-account | --follow pubkey | --unfollow pubkey]")
        }
    }
    failure := nostril_load_init(root)
    if failure.len() > 0 { panic(failure) }
    if follow_action {
        name := nostril_account_name()
        pubkey := nostril_account_public_key()
        error := nostril_account_follow(args[1], args[0] == "--unfollow")
        nostril_config_reset()
        if error.len() > 0 { panic(error) }
        println("Follow list saved locally for ", name, " (", pubkey, ")")
        return
    }
    mut endpoint := nostril_account_relay()
    if args.len() > 0 {
        endpoint = NOSTRIL_LIVE_ENDPOINT
        if args.len() == 2 { endpoint = args[1].clone() }
    }
    mut session := AccountFeed()
    session.open(endpoint)

    background := Color(r = 24, g = 24, b = 24, a = 255)
    field := Color(r = 32, g = 32, b = 32, a = 255)
    border := Color(r = 64, g = 64, b = 64, a = 255)
    text := Color(r = 232, g = 232, b = 232, a = 255)
    muted := Color(r = 152, g = 152, b = 152, a = 255)
    action := Color(r = 74, g = 112, b = 170, a = 255)

    mut composer := ""
    mut composer_scalars : I32 = 0
    // Panels replace the timeline temporarily; the main feed stays full-width.
    mut panel : I32 = 0
    mut scroll : I32 = 0
    mut timeline_scroll : USize = 0
    mut follow_input := ""
    mut editing_key := ""
    mut petname_input := ""
    mut account_input := ""
    mut notice := ""

    SetConfigFlags(FLAG_WINDOW_RESIZABLE.cast(U32))
    InitWindow(900, 640, "Nostril".c_str)
    SetWindowMinSize(480, 320)
    SetTargetFPS(60)

    while !WindowShouldClose() {
        session.poll()
        width := GetScreenWidth()
        height := GetScreenHeight()
        margin : I32 = 12
        content_x := margin
        content_w := width - margin * 2
        header_h : I32 = 76
        composer_h : I32 = 56
        composer_y := height - composer_h
        field_x := margin
        field_y := composer_y + 8
        field_h : I32 = 40
        button_w : I32 = 64
        field_w := width - margin * 3 - button_w
        button_x := field_x + field_w + margin

        clicked := IsMouseButtonPressed(0)
        if clicked && gui_hit(width - 108, 44, 96, 24) {
            npub := nostril_public_key_npub(nostril_account_public_key())
            SetClipboardText(npub.c_str)
        }
        if clicked && gui_hit(margin, 8, 210, 30) {
            if panel == 1 { panel = 0 } else { panel = 1 }
            scroll = 0; notice = ""
        }
        if clicked && gui_hit(width - 108, 8, 96, 30) {
            if panel == 2 { panel = 0 } else { panel = 2 }
            scroll = 0; notice = ""
        }
        if panel > 0 && clicked && gui_hit(width - 180, 8, 60, 30) {
            if panel == 3 { panel = 2 }
            else if panel == 4 { panel = 1 }
            else { panel = 0 }
            notice = ""
        }
        if panel > 0 {
            wheel := GetMouseWheelMove()
            if wheel > 0 { scroll = scroll - 3 }
            else if wheel < 0 { scroll = scroll + 3 }
            if scroll < 0 { scroll = 0 }
        } else {
            wheel := GetMouseWheelMove()
            if wheel > 0 { timeline_scroll = timeline_scroll + 3 }
            else if wheel < 0 {
                if timeline_scroll > 3 { timeline_scroll = timeline_scroll - 3 }
                else { timeline_scroll = 0 }
            }
        }
        if session.messages.len() == 0 { timeline_scroll = 0 }
        else if timeline_scroll >= session.messages.len() { timeline_scroll = session.messages.len() - 1 }
        if IsKeyPressed(259) || IsKeyPressedRepeat(259) {
            if panel == 0 && composer_scalars > 0 {
                composer = text_without_last_grapheme(composer)
                composer_scalars = text_scalar_count(composer).to_i64().to_i32()
            } else if panel == 2 { follow_input = text_without_last_grapheme(follow_input) }
            else if panel == 3 { petname_input = text_without_last_grapheme(petname_input) }
            else if panel == 4 { account_input = text_without_last_grapheme(account_input) }
        }
        if (panel == 2 || panel == 3 || panel == 4) && (IsKeyDown(341) || IsKeyDown(345)) && IsKeyPressed(86) {
            ref clipboard : I8 = GetClipboardText()
            if clipboard.is_null() { notice = "Clipboard has no text." }
            else {
                pasted := Str.from_c_str(clipboard)
                if panel == 2 {
                    candidate := pasted.trim().clone()
                    if candidate.len() <= 5006 { follow_input = candidate.clone() }
                    else { notice = "Public identity is too long (maximum 5000 characters plus nostr:)." }
                } else if panel == 3 {
                    if pasted.len() <= 64 { petname_input = pasted.clone() }
                    else { notice = "Petnames have at most 64 characters." }
                } else {
                    if pasted.len() <= 64 { account_input = pasted.clone() }
                    else { notice = "Local account names have at most 64 UTF-8 bytes." }
                }
            }
        }
        mut code := GetCharPressed()
        while code > 0 {
            if code >= 32 && code != 127 {
                if panel == 0 && composer_scalars < 280 {
                    composer = format(composer, Str.from_codepoint(code.cast(I64))); composer_scalars++
                } else if panel == 2 && follow_input.len() < 5006 && code < 128 {
                    follow_input = format(follow_input, Str.from_codepoint(code.cast(I64)))
                } else if panel == 3 && petname_input.len() < 64 && code < 128 {
                    petname_input = format(petname_input, Str.from_codepoint(code.cast(I64)))
                } else if panel == 3 && code >= 128 { notice = "Use ASCII letters, digits or underscore." }
                else if panel == 4 {
                    character := Str.from_codepoint(code.cast(I64))
                    if account_input.len() + character.len() <= 64 { account_input = format(account_input, character) }
                }
            }
            code = GetCharPressed()
        }
        if panel == 1 {
            if clicked && gui_hit(width - 152, 80, 140, 22) {
                account_input = ""; notice = ""; panel = 4
            }
            count := nostril_account_count().to_i32()
            visible := (height - 148) / 34
            mut maximum := count - visible
            if maximum < 0 { maximum = 0 }
            if scroll > maximum { scroll = maximum }
            for index in 0..nostril_account_count() {
                row_y : I32 = 104 + (index.to_i32() - scroll) * 34
                if row_y < 104 || row_y + 30 > height - 44 { continue }
                if clicked && gui_hit(margin, row_y, content_w, 30) {
                    name := nostril_account_name_at(index)
                    if name == nostril_account_name() { panel = 0 }
                    else {
                        error := session.switch_account(root, name)
                        if error.len() > 0 { notice = error.clone() }
                        else {
                            composer = ""; composer_scalars = 0; follow_input = ""
                            editing_key = ""; petname_input = ""
                            notice = ""; panel = 0; scroll = 0; timeline_scroll = 0
                        }
                    }
                }
            }
        }
        if panel == 2 {
            if nostril_account_persistent() && (IsKeyPressed(257) ||
                    (clicked && gui_hit(width - 88, 88, 76, 36))) {
                error := session.follow(follow_input.trim(), false)
                if error.len() > 0 { notice = error.clone() }
                else { follow_input = ""; timeline_scroll = 0; notice = "Follow saved locally; feed updated." }
            }
            follows := nostril_account_follows()
            mut count : I32 = 0
            for pubkey : Str in follows.split("\n") { if pubkey.len() > 0 { count++ } }
            mut maximum := count - (height - 200) / 46
            if maximum < 0 { maximum = 0 }
            if scroll > maximum { scroll = maximum }
            mut row : I32 = 0
            for pubkey : Str in follows.split("\n") {
                if pubkey.len() == 0 { continue }
                row_y : I32 = 156 + (row - scroll) * 46
                row++
                if row_y < 156 || row_y + 42 > height - 44 { continue }
                if clicked && gui_hit(width - 216, row_y, 48, 28) {
                    npub := nostril_public_key_npub(pubkey)
                    SetClipboardText(npub.c_str); notice = "Public key copied as npub."
                }
                if clicked && gui_hit(width - 156, row_y, 60, 28) {
                    editing_key = pubkey.clone()
                    petname_input = nostril_account_petname(pubkey)
                    notice = ""; panel = 3
                }
                if clicked && gui_hit(width - 88, row_y, 76, 28) {
                    error := session.follow(pubkey, true)
                    if error.len() > 0 { notice = error.clone() }
                    else { timeline_scroll = 0; notice = "Unfollow saved locally; feed updated." }
                }
            }
        }
        if panel == 3 {
            if clicked && gui_hit(width - 88, 88, 76, 28) {
                npub := nostril_public_key_npub(editing_key)
                SetClipboardText(npub.c_str); notice = "Public key copied as npub."
            }
            clear := clicked && gui_hit(margin, 212, 96, 30)
            if clear { petname_input = "" }
            if clear || IsKeyPressed(257) || (clicked && gui_hit(width - 88, 156, 76, 36)) {
                error := nostril_account_set_petname(editing_key, petname_input)
                if error.len() > 0 { notice = error.clone() }
                else { panel = 2; notice = "Petname saved locally." }
            }
        }
        if panel == 4 && (IsKeyPressed(257) || (clicked && gui_hit(width - 108, 156, 96, 36))) {
            error := session.create_account(root, account_input)
            if error.len() > 0 { notice = error.clone() }
            else {
                composer = ""; composer_scalars = 0; follow_input = ""
                editing_key = ""; petname_input = ""; account_input = ""
                notice = ""; panel = 0; scroll = 0; timeline_scroll = 0
            }
        }
        button_hover := gui_hit(button_x, field_y, button_w, field_h)
        submit := IsKeyPressed(257) || (button_hover && IsMouseButtonPressed(0))
        if panel == 0 && submit && composer.trim().len() > 0 {
            session.send(composer)
            timeline_scroll = 0
            composer = ""
            composer_scalars = 0
        }

        BeginDrawing()
        ClearBackground(background)

        DrawRectangle(0, header_h - 1, width, 1, border)
        DrawRectangle(margin, 8, 210, 30, field)
        account_label := gui_fitting_tail(format("Account: ", nostril_account_name()), 194, 14)
        DrawText(account_label.c_str, margin + 8, 16, 14, text)
        DrawRectangle(width - 108, 8, 96, 30, field)
        DrawText("Following".c_str, width - 100, 16, 14, text)
        if panel > 0 { DrawText("Back".c_str, width - 174, 16, 14, text) }
        public_key := nostril_account_public_key()
        status := gui_fitting_tail(format(public_key.substr(0, 16), "... | ",
            gui_status_text(session.status())), content_w - 108, 13)
        DrawText(status.c_str, margin, 50, 13, muted)
        DrawRectangle(width - 108, 44, 96, 24, field)
        DrawText("Copy npub".c_str, width - 100, 50, 13, text)

        if panel == 0 {
            timeline_top := header_h + 8
            timeline_bottom := composer_y - 8
            if session.messages.len() == 0 {
                DrawText("No messages.".c_str, content_x, timeline_top + 4, 14, muted)
            } else {
                BeginScissorMode(content_x, timeline_top, content_w, timeline_bottom - timeline_top)
                mut bottom := timeline_bottom
                mut index := session.messages.len() - timeline_scroll
                while index > 0 && bottom > timeline_top {
                    index--
                    ref event : Str = session.messages[index]
                    message := nostril_relay_event_content(event)
                    message_x := content_x + 48
                    message_w := content_w - 48
                    line_count := gui_wrapped_lines(message, message_w, 16)
                    row_h : I32 = 54 + line_count * 21
                    row_y : I32 = bottom - row_h
                    author := nostril_relay_event_pubkey(event)
                    author_label := gui_fitting_head(nostril_account_author_label(author), content_w - 180, 13)
                    key_hint := format(author.substr(0, 8), "...", author.substr(56, 8))
                    DrawText(author_label.c_str, content_x, row_y + 7, 13, text)
                    DrawText(key_hint.c_str, width - margin - MeasureText(key_hint.c_str, 12), row_y + 7, 12, muted)
                    if row_y + 3 >= timeline_top && row_y + 23 <= timeline_bottom &&
                            clicked && gui_hit(content_x, row_y + 3, content_w, 20) {
                        npub := nostril_public_key_npub(author)
                        SetClipboardText(npub.c_str)
                    }
                    gui_draw_wrapped(message, message_x, row_y + 27, message_w, 16, 21, text)
                    publication_status := gui_status_text(session.publication_status(event))
                    visible_status := gui_fitting_tail(publication_status, message_w, 11)
                    DrawText(visible_status.c_str, message_x, bottom - 15, 11, muted)
                    DrawRectangle(content_x, bottom - 1, content_w, 1, border)
                    bottom = row_y
                }
                EndScissorMode()
            }

            DrawRectangle(0, composer_y, width, composer_h, background)
            DrawRectangle(0, composer_y, width, 1, border)
            DrawRectangle(field_x, field_y, field_w, field_h, field)
            DrawRectangleLines(field_x, field_y, field_w, field_h, border)

            count := format(composer_scalars.to_str(), "/280")
            count_w := MeasureText(count.c_str, 11)
            input_w := field_w - count_w - 28
            BeginScissorMode(field_x + 10, field_y + 1, input_w, field_h - 2)
            if composer.len() == 0 {
                DrawText("Message".c_str, field_x + 10, field_y + 12, 16, muted)
            } else {
                visible := gui_fitting_tail(composer, input_w, 16)
                DrawText(visible.c_str, field_x + 10, field_y + 12, 16, text)
                if (GetTime() * 2).to_i64().mod(2) == 0 {
                    caret_x := field_x + 12 + MeasureText(visible.c_str, 16)
                    DrawRectangle(caret_x, field_y + 10, 1, 21, text)
                }
            }
            EndScissorMode()
            DrawText(count.c_str, field_x + field_w - count_w - 8, field_y + 14, 11, muted)

            mut button_color := border
            if composer.trim().len() > 0 { button_color = action }
            if button_hover && composer.trim().len() > 0 {
                button_color = Color(r = 88, g = 128, b = 188, a = 255)
            }
            DrawRectangle(button_x, field_y, button_w, field_h, button_color)
            send_label := "Send"
            send_x := button_x + (button_w - MeasureText(send_label.c_str, 14)) / 2
            DrawText(send_label.c_str, send_x, field_y + 13, 14, text)
        } else {
            BeginScissorMode(margin, header_h + 1, content_w, height - header_h - 2)
            if panel == 1 {
                hint := gui_fitting_head("Switching clears draft/feed and pending retries.", content_w - 152, 12)
                DrawText(hint.c_str, margin, 84, 12, muted)
                DrawRectangle(width - 152, 80, 140, 22, action)
                DrawText("New account".c_str, width - 142, 84, 14, text)
                if nostril_account_count() == 0 {
                    DrawText("No saved accounts. Create one to get started.".c_str, margin, 110, 14, muted)
                }
                for index in 0..nostril_account_count() {
                    row_y : I32 = 104 + (index.to_i32() - scroll) * 34
                    if row_y < 104 || row_y + 30 > height - 44 { continue }
                    name := nostril_account_name_at(index)
                    mut color := field
                    if name == nostril_account_name() { color = action }
                    DrawRectangle(margin, row_y, content_w, 30, color)
                    label := gui_fitting_tail(name, content_w - 16, 14)
                    DrawText(label.c_str, margin + 8, row_y + 8, 14, text)
                }
            } else if panel == 2 {
                DrawRectangle(margin, 88, width - 112, 36, field)
                mut input_label := "npub, nprofile or hex (Ctrl+V to paste)"
                if follow_input.len() > 0 { input_label = gui_fitting_tail(follow_input, width - 132, 14) }
                DrawText(input_label.c_str, margin + 8, 99, 14, text)
                mut color := border
                if nostril_account_persistent() { color = action }
                DrawRectangle(width - 88, 88, 76, 36, color)
                DrawText("Follow".c_str, width - 78, 99, 14, text)
                mut hint := "Following for this account (saved locally)"
                if !nostril_account_persistent() { hint = "Select a persistent account to manage follows." }
                DrawText(hint.c_str, margin, 134, 12, muted)
                follows := nostril_account_follows()
                if follows.len() == 0 { DrawText("No follows yet.".c_str, margin, 164, 14, muted) }
                mut row : I32 = 0
                for pubkey : Str in follows.split("\n") {
                    if pubkey.len() == 0 { continue }
                    row_y : I32 = 156 + (row - scroll) * 46
                    row++
                    if row_y < 156 || row_y + 42 > height - 44 { continue }
                    label := gui_fitting_head(nostril_account_author_label(pubkey), width - 240, 14)
                    key_hint := format(pubkey.substr(0, 8), "...", pubkey.substr(56, 8))
                    DrawText(label.c_str, margin, row_y + 3, 14, text)
                    DrawText(key_hint.c_str, margin, row_y + 23, 11, muted)
                    DrawRectangle(width - 216, row_y, 48, 28, field)
                    DrawText("Key".c_str, width - 208, row_y + 7, 13, text)
                    DrawRectangle(width - 156, row_y, 60, 28, field)
                    DrawText("Name".c_str, width - 148, row_y + 7, 13, text)
                    DrawRectangle(width - 88, row_y, 76, 28, field)
                    DrawText("Unfollow".c_str, width - 82, row_y + 7, 13, text)
                }
            } else if panel == 3 {
                DrawText("Petname for this public key".c_str, margin, 92, 14, text)
                DrawRectangle(width - 88, 88, 76, 28, field)
                DrawText("Copy key".c_str, width - 82, 95, 13, text)
                DrawText(editing_key.c_str, margin, 128, 12, muted)
                DrawRectangle(margin, 156, width - 112, 36, field)
                DrawRectangleLines(margin, 156, width - 112, 36, action)
                input_label := gui_fitting_tail(petname_input, width - 132, 14)
                DrawText(input_label.c_str, margin + 8, 167, 14, text)
                DrawRectangle(width - 88, 156, 76, 36, action)
                DrawText("Save".c_str, width - 76, 167, 14, text)
                DrawRectangle(margin, 212, 96, 30, field)
                DrawText("Clear name".c_str, margin + 8, 220, 13, text)
                DrawText("Letters, digits, underscore; names are per account.".c_str, margin, 254, 12, muted)
            } else {
                DrawText("Create a new account".c_str, margin, 92, 18, text)
                DrawText("Local name (up to 64 UTF-8 bytes)".c_str, margin, 132, 13, muted)
                DrawRectangle(margin, 156, width - 132, 36, field)
                DrawRectangleLines(margin, 156, width - 132, 36, action)
                label := gui_fitting_tail(account_input, width - 152, 14)
                DrawText(label.c_str, margin + 8, 167, 14, text)
                DrawRectangle(width - 108, 156, 96, 36, action)
                DrawText("Create".c_str, width - 94, 167, 14, text)
                hint := gui_fitting_head("Creates a fresh keypair, saves it locally and switches to it.", content_w, 12)
                DrawText(hint.c_str, margin, 212, 12, muted)
                DrawText("This name stays on this device; it is not a public profile name.".c_str, margin, 238, 12, muted)
            }
            visible_notice := gui_fitting_head(notice, content_w, 12)
            DrawText(visible_notice.c_str, margin, height - 28, 12, muted)
            EndScissorMode()
        }

        EndDrawing()
    }

    CloseWindow()
    session.close()
    nostril_config_reset()
}
