mode lib
import("../lib/modes/nostril_live")
import("../gen/websocket_api")
import("../gen/nostril_startup_api")

// One active GUI feed. The host closes it before switching identities or exit.
// Native handles are not copied into inactive-account snapshots.
AccountFeed := struct {
    endpoint := ""
    live := false
    remote := false
    socket := nng_socket()
    publisher := nng_socket()
    websocket : I64 = 0
    feed := FeedClient()
    outbox := Vec(Publication).new()
    messages := Vec(Str).new()
namespace:
    open := proc(mut self: AccountFeed, endpoint: Str) {
        self.endpoint = endpoint.clone()
        self.live = endpoint.len() > 0
        self.remote = self.live && (endpoint.starts_with("ws://") || endpoint.starts_with("wss://"))
        self.feed = FeedClient(request = nostril_account_subscription())
        if self.remote {
            self.websocket = nostril_ws_open(endpoint)
            if self.websocket == 0 { panic("could not create WebSocket client") }
            nostril_ws_subscribe(self.websocket, self.feed.request)
        } else if self.live {
            nostril_live_open(self.socket, endpoint, false)
            nostril_publish_open(self.publisher, endpoint, false)
        }
    }
    close := proc(mut self: AccountFeed) {
        if self.remote { nostril_ws_close(self.websocket) }
        else if self.live {
            nostril_live_send(self.socket, NOSTRIL_LOCAL_CLOSE)
            nostril_nng_close(self.publisher)
            nostril_nng_close(self.socket)
        }
        self.live = false; self.remote = false; self.websocket = 0
        self.outbox.clear(); self.messages.clear()
    }
    switch_account := proc(mut self: AccountFeed, root: Str, name: Str) returns Str {
        error := nostril_account_switch(root, name)
        if error.len() > 0 { return error }
        endpoint := self.endpoint.clone()
        self.close()
        self.open(endpoint)
        return ""
    }
    create_account := proc(mut self: AccountFeed, root: Str, name: Str) returns Str {
        result := nostril_account_create_named(root, name)
        if !nostril_key_encoding(result) { return result }
        return self.switch_account(root, name)
    }
    refresh := proc(mut self: AccountFeed) {
        self.feed = FeedClient(request = nostril_account_subscription())
        if self.remote { nostril_ws_subscribe(self.websocket, self.feed.request) }
        mut matching := Vec(Str).new()
        for message : Str in self.messages {
            if nostril_subscription_matches_relay(self.feed.request, message) { matching.push(own message.clone()) }
        }
        self.messages = matching.clone()
    }
    follow := proc(mut self: AccountFeed, pubkey: Str, remove: Bool) returns Str {
        error := nostril_account_follow(pubkey, remove)
        if error.len() == 0 { self.refresh() }
        return error
    }
    poll := proc(mut self: AccountFeed) {
        if self.remote {
            nostril_ws_poll(self.websocket)
            mut budget : I64 = 32
            while budget > 0 {
                message := nostril_ws_receive(self.websocket)
                if message.len() == 0 { break }
                // Also filter events queued before a follow-list edit.
                if nostril_subscription_matches_relay(self.feed.request, message) {
                    nostril_live_accept(self.messages, message)
                }
                budget--
            }
        } else if self.live {
            nostril_feed_poll(self.socket, self.feed, self.messages)
            if self.feed.ready { nostril_publish_poll(self.publisher, self.outbox) }
        }
    }
    send := proc(mut self: AccountFeed, content: Str) {
        event := nostril_account_sign(content, nostril_now())
        if !nostril_event_is_valid(event) { panic("newly signed event did not verify") }
        nostril_live_accept(self.messages, nostril_live_envelope(event))
        if self.remote { nostril_ws_publish(self.websocket, event) }
        else if self.live { nostril_publish_queue(self.outbox, event) }
    }
    status := proc(self: AccountFeed) returns Str {
        if self.remote { return nostril_ws_status(self.websocket) }
        if !self.live { return "Local only" }
        if self.feed.ready { return "Live subscription" }
        return "Loading recent notes..."
    }
    publication_status := proc(self: AccountFeed, event: Str) returns Str {
        if self.remote { return nostril_ws_publication_status(self.websocket, nostril_relay_event_id(event)) }
        if self.live { return nostril_publish_label(self.outbox, nostril_relay_event_id(event)) }
        return "local only"
    }
}
