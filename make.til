#!/usr/bin/env -S til run
mode cli

// Run from the repository root: ./make.til (or til run make.til).
import("std/sys")
import("std/file")

get_cwd_str := ext_proc() returns Str {}

BASE_VERSION := "0.0.1-"

get_version := macro() returns shallow Str {
    mut hash : Str = ""
    status := run_cmd(hash, "git", "rev-parse", "--short", "HEAD")
    if status != 0 { panic("cannot derive the Nostril version from git") }
    return format(BASE_VERSION, hash.replace("\n", ""))
}

VERSION := get_version()

record_til_dependency := proc() {
    command := Cmd.new("til", "-v")
    command.capture_out()
    command.run_checked()
    output := command.out()
    File.writefile("doc/til-dependency.org", format(
        "* Til build dependency\n\n",
        "Generated by =make.til= after a successful full build. Do not edit.\n\n",
        "Compiler used: =", output.trim(), "=.\n\n",
        "This records the compiler used for the build, not a minimum version or\n",
        "a guarantee that the complete test suite passed. Builds use =til= on =PATH=\n",
        "and its matching installed support tree. Regenerate with =./make.til=.\n"))
}

generate_version := proc() {
    File.writefile("gen/nostril_version.til",
        format("mode lib\nNOSTRIL_VERSION := \"", VERSION, "\"\n"))
}

library := proc(opt: Str) {
    Cmd.new("til", "build", "--cpu=baseline", "--usize=64", opt,
        "-c", "gen/nostril.c", "lib/nostril/nostril.til").run_checked()
}

select_api := proc() {
    path := format(get_cwd_str(), "/gen/lib/libnostril.a")
    if !File.is_file(path) { panic("missing library: ", path) }
    escaped := path.replace("\\", "\\\\").replace("\"", "\\\"")
    File.writefile("gen/nostril_api.til", format(
        "mode lib\n",
        "link(\"", escaped, "\")\n",
        "link(\"vendor/secp256k1/libsecp256k1.a\")\n\n",
        "til_nostril__nostril_version := ext_func() returns shallow Str {}\n",
        "nostril_version := func() returns Str { return til_nostril__nostril_version() }\n\n",
        "til_nostril__nostril_generate_secret_key := ext_proc() returns shallow Str {}\n",
        "nostril_generate_secret_key := proc() returns Str { return til_nostril__nostril_generate_secret_key() }\n\n",
        "til_nostril__nostril_pubkey := ext_proc(secret_key: Str) returns shallow Str {}\n",
        "nostril_pubkey := proc(secret_key: Str) returns Str { return til_nostril__nostril_pubkey(secret_key) }\n\n",
        "til_nostril__nostril_now := ext_proc() returns shallow I64 {}\n",
        "nostril_now := proc() returns I64 { return til_nostril__nostril_now() }\n\n",
        "til_nostril__nostril_sign_text_note := ext_proc(secret_key: Str, content: Str, shallow created_at: I64) returns shallow Str {}\n",
        "nostril_sign_text_note := proc(secret_key: Str, content: Str, created_at: I64) returns Str { return til_nostril__nostril_sign_text_note(secret_key, content, created_at) }\n\n",
        "til_nostril__nostril_event_is_valid := ext_proc(event_json: Str) returns shallow Bool {}\n",
        "nostril_event_is_valid := proc(event_json: Str) returns Bool { return til_nostril__nostril_event_is_valid(event_json) }\n\n",
        "til_nostril__nostril_event_content := ext_proc(event_json: Str) returns shallow Str {}\n",
        "nostril_event_content := proc(event_json: Str) returns Str { return til_nostril__nostril_event_content(event_json) }\n\n",
        "til_nostril__nostril_relay_event_is_valid := ext_proc(message: Str) returns shallow Bool {}\n",
        "nostril_relay_event_is_valid := proc(message: Str) returns Bool { return til_nostril__nostril_relay_event_is_valid(message) }\n\n",
        "til_nostril__nostril_relay_event_content := ext_proc(message: Str) returns shallow Str {}\n",
        "nostril_relay_event_content := proc(message: Str) returns Str { return til_nostril__nostril_relay_event_content(message) }\n",
        "til_nostril__nostril_event_id := ext_proc(event_json: Str) returns shallow Str {}\n",
        "nostril_event_id := proc(event_json: Str) returns Str { return til_nostril__nostril_event_id(event_json) }\n",
        "til_nostril__nostril_relay_event_id := ext_proc(message: Str) returns shallow Str {}\n",
        "nostril_relay_event_id := proc(message: Str) returns Str { return til_nostril__nostril_relay_event_id(message) }\n",
        "til_nostril__nostril_publication_reply := ext_proc(event_json: Str, shallow duplicate: Bool) returns shallow Str {}\n",
        "nostril_publication_reply := proc(event_json: Str, duplicate: Bool) returns Str { return til_nostril__nostril_publication_reply(event_json, duplicate) }\n",
        "til_nostril__nostril_publication_status := ext_func(reply: Str, expected_id: Str) returns shallow Str {}\n",
        "nostril_publication_status := func(reply: Str, expected_id: Str) returns Str { return til_nostril__nostril_publication_status(reply, expected_id) }\n",
        "til_nostril__nostril_subscription_id := ext_func(message: Str) returns shallow Str {}\n",
        "nostril_subscription_id := func(message: Str) returns Str { return til_nostril__nostril_subscription_id(message) }\n",
        "til_nostril__nostril_control_id := ext_func(message: Str, wanted: Str) returns shallow Str {}\n",
        "nostril_control_id := func(message: Str, wanted: Str) returns Str { return til_nostril__nostril_control_id(message, wanted) }\n",
        "til_nostril__nostril_subscription_matches := ext_proc(request: Str, event_json: Str) returns shallow Bool {}\n",
        "nostril_subscription_matches := proc(request: Str, event_json: Str) returns Bool { return til_nostril__nostril_subscription_matches(request, event_json) }\n",
        "til_nostril__nostril_subscription_response := ext_func(request: Str) returns shallow Str {}\n",
        "nostril_subscription_response := func(request: Str) returns Str { return til_nostril__nostril_subscription_response(request) }\n",
        "til_nostril__nostril_subscription_envelope := ext_func(id: Str, event_json: Str) returns shallow Str {}\n",
        "nostril_subscription_envelope := func(id: Str, event_json: Str) returns Str { return til_nostril__nostril_subscription_envelope(id, event_json) }\n"))
}

build_nng := proc() {
    if !File.is_file("vendor/nng/CMakeLists.txt") {
        panic("missing vendored NNG source under vendor/nng/")
    }
    if mkdir_p("gen/nng") != 0 { panic("could not create gen/nng/") }
    Cmd.new("cmake", "-S", "vendor/nng", "-B", "gen/nng/build",
        "-DCMAKE_BUILD_TYPE=Release", "-DBUILD_SHARED_LIBS=OFF",
        "-DNNG_TESTS=OFF", "-DNNG_TOOLS=OFF", "-DNNG_ENABLE_TLS=OFF",
        "-DCMAKE_POSITION_INDEPENDENT_CODE=ON").run_checked()
    Cmd.new("cmake", "--build", "gen/nng/build", "--parallel").run_checked()

    archive := "gen/nng/build/libnng.a"
    if !File.is_file(archive) { panic("NNG build did not produce ", archive) }
    Cmd.new("cp", archive, "gen/nng/libnng.a").run_checked()
    // Keep routed-message helpers and NNG in the same native module. A separate
    // interpreter link_c bridge can load a second NNG socket registry.
    Cmd.new("cc", "-fPIC", "-Wall", "-Wextra", "-Werror", "-c", "lib/feed.c",
        "-o", "gen/nng/feed.o").run_checked()
    Cmd.new("ar", "rcs", "gen/nng/libnng.a", "gen/nng/feed.o").run_checked()
    // The interpreter dlopens a shared twin beside each linked archive.
    Cmd.new("cc", "-shared", "-fPIC", "-o", "gen/nng/libnng.so",
        "-Wl,--whole-archive", "gen/nng/libnng.a", "-Wl,--no-whole-archive",
        "-lpthread", "-latomic").run_checked()

    path := format(get_cwd_str(), "/gen/nng/libnng.a")
    escaped := path.replace("\\", "\\\\").replace("\"", "\\\"")
    File.writefile("gen/nng_link.til", format("mode lib\nlink(\"", escaped,
        "\")\nlink(\"pthread\")\nlink(\"atomic\")\n"))
}

build := proc(name: Str, source: Str, opt: Str) {
    Cmd.new("til", "build", "--cpu=baseline", "--usize=64", opt,
        "-o", format("bin/", name), "-c", format("gen/", name, ".c"), source).run_checked()
}

build_mode := proc(name: Str, source: Str, opt: Str) {
    Cmd.new("til", "build", "--cpu=baseline", "--usize=64", opt,
        "--extra-modes=modes.til", "-o", format("bin/", name),
        "-c", format("gen/", name, ".c"), source).run_checked()
}

run_tests := proc(opt: Str) {
    build_mode("nostril-cli", "src/nostril_cli.til", opt)
    build_mode("nostril-relay", "src/nostril_relay.til", opt)
    Cmd.new("til", "test", "--cpu=baseline", "--usize=64", opt,
        "-o", "bin/nostril-tests", "-c", "gen/nostril-tests.c",
        "tests.til").run_checked()
}

main := proc(args: ..Str) {
    if args.len() == 1 && args[0] == "clean" {
        if !File.is_file("make.til") || !File.is_file("src/nostril_cli.til") {
            panic("run clean from the Nostril repository root")
        }
        for path : Str in array(Str, "bin", "gen", "tmp") { File.remove_tree(path) }
        return
    }

    mut target := "build"
    mut opt := "--opt=0"
    for arg : Str in args {
        if arg.starts_with("--opt=") { opt = arg.clone() }
        else if target == "build" { target = arg.clone() }
        else { panic("unknown build argument: ", arg) }
    }
    if (target != "build" && target != "library" && target != "test") ||
        (opt != "--opt=0" && opt != "--opt=2" && opt != "--opt=3") {
        panic("usage: ./make.til [build|library|test] [--opt=0|--opt=2|--opt=3], or clean")
    }
    if mkdir_p("bin") != 0 { panic("could not create bin/") }
    if mkdir_p("gen") != 0 { panic("could not create gen/") }

    generate_version()
    library(opt)
    if target == "library" { return }
    select_api()
    build_nng()
    if target == "test" { run_tests(opt); return }
    build_mode("nostril-cli", "src/nostril_cli.til", opt)
    build_mode("nostril-relay", "src/nostril_relay.til", opt)
    build("nostril-gui", "src/nostril_gui.til", opt)
    record_til_dependency()
}
