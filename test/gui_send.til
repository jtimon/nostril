mode cli

import("std/sys")
import("std/file")
import("../gen/nostril_api")
link("X11")
link(":libXtst.so.6")

XOpenDisplay := ext_proc(name: I8) returns ref Dynamic {}
XCloseDisplay := ext_proc(display: Dynamic) returns shallow I32 {}
XSetInputFocus := ext_proc(display: Dynamic, shallow window: UPtr, shallow revert: I32, shallow time: UPtr) returns shallow I32 {}
XKeysymToKeycode := ext_proc(display: Dynamic, shallow keysym: UPtr) returns shallow U8 {}
XTestFakeKeyEvent := ext_proc(display: Dynamic, shallow key: U32, shallow pressed: I32, shallow delay: UPtr) returns shallow I32 {}
XTestFakeMotionEvent := ext_proc(display: Dynamic, shallow screen: I32, shallow x: I32, shallow y: I32, shallow delay: UPtr) returns shallow I32 {}
XTestFakeButtonEvent := ext_proc(display: Dynamic, shallow button: U32, shallow pressed: I32, shallow delay: UPtr) returns shallow I32 {}
XFlush := ext_proc(display: Dynamic) returns shallow I32 {}
XDefaultRootWindow := ext_proc(display: Dynamic) returns shallow UPtr {}
XGetGeometry := ext_proc(display: Dynamic, shallow window: UPtr, mut root: UPtr, mut x: I32, mut y: I32,
    mut width: U32, mut height: U32, mut border: U32, mut depth: U32) returns shallow I32 {}
XTranslateCoordinates := ext_proc(display: Dynamic, shallow source: UPtr, shallow destination: UPtr,
    shallow x: I32, shallow y: I32, mut root_x: I32, mut root_y: I32, mut child: UPtr) returns shallow I32 {}
XGetImage := ext_proc(display: Dynamic, shallow window: UPtr, shallow x: I32, shallow y: I32,
    shallow width: U32, shallow height: U32, shallow planes: UPtr, shallow format: I32) returns ref Dynamic {}
XGetPixel := ext_proc(image: Dynamic, shallow x: I32, shallow y: I32) returns shallow UPtr {}
XDestroyImage := ext_proc(image: Dynamic) returns shallow I32 {}

region_matches := proc(display: Dynamic, window: UPtr, x: I32, y: I32, reference: Dynamic) returns Bool {
    ref actual : Dynamic = XGetImage(display, window, x, y, 180, 24, 0xffffff, 2)
    if actual.is_null() { panic("could not capture GUI region") }
    mut equal := true
    // Pixel coordinates, rather than a collection of elements.
    for row in 0..24 {
        for column in 0..180 {
            if XGetPixel(reference, column.to_i32(), row.to_i32()) != XGetPixel(actual, column.to_i32(), row.to_i32()) { equal = false }
        }
    }
    XDestroyImage(actual)
    return equal
}

composer_is_empty := proc(display: Dynamic, window: UPtr, height: U32, reference: Dynamic) returns Bool {
    return region_matches(display, window, 22, height.cast(I32) - 38, reference)
}

find_window := proc() returns UPtr {
    query := Cmd.new("xwininfo", "-root", "-tree", "-int")
    query.capture()
    if query.run() != 0 { panic("xwininfo failed: ", query.err()) }
    output := query.out()
    for line : Str in output.split("\n") {
        if line.contains("\"Nostril\"") {
            text := line.trim().clone()
            fields := text.split(" ")
            // A named window can exist before it is mapped. XSetInputFocus
            // requires a viewable window; let the bounded polling loop wait.
            state := Cmd.new("xwininfo", "-id", fields[0])
            state.capture()
            if state.run() != 0 || !state.out().contains("Map State: IsViewable") { continue }
            return fields[0].to_u64().cast(UPtr)
        }
    }
    return 0
}

key := proc(display: Dynamic, symbol: UPtr) {
    code := XKeysymToKeycode(display, symbol).cast(U32)
    XTestFakeKeyEvent(display, code, 1, 0)
    XFlush(display)
    sleep_ms(25)
    XTestFakeKeyEvent(display, code, 0, 0)
    XFlush(display)
    sleep_ms(25)
}

click := proc(display: Dynamic, window: UPtr, x: I32, y: I32) {
    mut root_x : I32 = 0
    mut root_y : I32 = 0
    mut child : UPtr = 0
    if XTranslateCoordinates(display, window, XDefaultRootWindow(display),
            x, y, root_x, root_y, child) == 0 { panic("cannot locate GUI control") }
    XTestFakeMotionEvent(display, -1, root_x, root_y, 0)
    XTestFakeButtonEvent(display, 1, 1, 0); XFlush(display); sleep_ms(50)
    XTestFakeButtonEvent(display, 1, 0, 0); XFlush(display); sleep_ms(150)
}

paste := proc(display: Dynamic) {
    control := XKeysymToKeycode(display, 0xffe3).cast(U32)
    XTestFakeKeyEvent(display, control, 1, 0); XFlush(display)
    key(display, 'v')
    XTestFakeKeyEvent(display, control, 0, 0); XFlush(display); sleep_ms(150)
}

main := proc(args: ..Str) {
    if args.len() > 1 { panic("usage: gui_send [gui-binary]") }
    mut executable := "bin/nostril-gui"
    if args.len() == 1 { executable = args[0].clone() }
    // Local-only: this test never publishes to a public relay.
    app := Cmd.new("timeout", "60", executable)
    home := format("tmp/gui-send-", process_id().to_str())
    mkdir_p(home)
    create := Cmd.new(executable, "--create-account")
    create.env("HOME", home).env("XDG_CONFIG_HOME", "").capture()
    if create.run() != 0 { panic("could not create GUI test account: ", create.err()) }
    output := create.out()
    pubkey := output.trim().clone()
    create_second := Cmd.new(executable, "--create-account")
    create_second.env("HOME", home).env("XDG_CONFIG_HOME", "").capture()
    if create_second.run() != 0 { panic("could not create second GUI test account: ", create_second.out()) }
    second_output := create_second.out()
    second := second_output.trim().clone()
    template := File.readfile("gen/nostril_init.til")
    configured := template.replace("nostril_config_relay(\"\")", format(
        "nostril_config_relay(\"\")\nnostril_config_account(\"gui-test\", \"", pubkey,
        "\")\nnostril_config_account(\"second\", \"", second,
        "\")\nnostril_config_select(\"gui-test\")"))
    mkdir_p(format(home, "/.config/nostril"))
    File.writefile(format(home, "/.config/nostril/init.til"), configured)
    app.env("HOME", home).env("XDG_CONFIG_HOME", "")
    app.capture()
    app.start()
    mut window : UPtr = 0
    mut attempts : I64 = 0
    while window == 0 && !app.poll() && attempts < 100 {
        window = find_window()
        sleep_ms(50)
        attempts++
    }
    if window == 0 { panic("Nostril window did not appear") }
    display_name := get_env("DISPLAY")
    ref display : Dynamic = XOpenDisplay(display_name.c_str)
    if display.is_null() { panic("could not open X display") }
    XSetInputFocus(display, window, 1, 0)
    XFlush(display)
    sleep_ms(150)

    mut root : UPtr = 0
    mut x : I32 = 0
    mut y : I32 = 0
    mut width : U32 = 0
    mut height : U32 = 0
    mut border : U32 = 0
    mut depth : U32 = 0
    if XGetGeometry(display, window, root, x, y, width, height, border, depth) == 0 { panic("missing GUI geometry") }
    ref empty : Dynamic = XGetImage(display, window, 22, height.cast(I32) - 38, 180, 24, 0xffffff, 2)
    if empty.is_null() { panic("could not capture empty composer") }
    for character : I8 in "first message" { key(display, character.cast(U8).cast(UPtr)) }
    if composer_is_empty(display, window, height, empty) { panic("typing did not reach the composer") }
    mut root_x : I32 = 0
    mut root_y : I32 = 0
    mut child : UPtr = 0
    if XTranslateCoordinates(display, window, XDefaultRootWindow(display),
        width.cast(I32) - 44, height.cast(I32) - 28, root_x, root_y, child) == 0 { panic("cannot locate Send") }
    XTestFakeMotionEvent(display, -1, root_x, root_y, 0)
    XTestFakeButtonEvent(display, 1, 1, 0)
    XFlush(display)
    sleep_ms(50)
    XTestFakeButtonEvent(display, 1, 0, 0)
    XFlush(display)
    sleep_ms(500)
    if app.poll() { panic("GUI failed on Send: ", app.out(), app.err()) }
    if !composer_is_empty(display, window, height, empty) { panic("Send did not clear the composer") }

    for character : I8 in "second message" { key(display, character.cast(U8).cast(UPtr)) }
    key(display, 0xff0d)
    sleep_ms(500)
    if app.poll() { panic("GUI failed on Enter: ", app.out(), app.err()) }
    if !composer_is_empty(display, window, height, empty) { panic("Enter did not clear the composer") }
    ref recent : Dynamic = XGetImage(display, window, 22, height.cast(I32) - 108, 180, 24, 0xffffff, 2)
    if recent.is_null() { panic("could not capture recent feed") }
    XTestFakeButtonEvent(display, 4, 1, 0); XTestFakeButtonEvent(display, 4, 0, 0); XFlush(display)
    sleep_ms(150)
    assert(!region_matches(display, window, 22, height.cast(I32) - 108, recent))
    XTestFakeButtonEvent(display, 5, 1, 0); XTestFakeButtonEvent(display, 5, 0, 0); XFlush(display)
    sleep_ms(150)
    assert(region_matches(display, window, 22, height.cast(I32) - 108, recent))
    XDestroyImage(recent)

    // Manage follows through real controls, then switch identities and verify
    // the signed lists stay with their owners. Enter in this panel is Follow.
    click(display, window, width.cast(I32) - 60, 24)
    // Xvfb starts without a text selection. Paste must not dereference null.
    paste(display)
    second_identity := nostril_public_key_npub(second)
    for character : I8 in second_identity { key(display, character.cast(U8).cast(UPtr)) }
    key(display, 0xff0d); sleep_ms(200)
    // The follow-row copy control must yield a checksummed npub usable in the
    // same input without changing the protocol/storage key or duplicating it.
    click(display, window, width.cast(I32) - 190, 168)
    paste(display)
    key(display, 0xff0d); sleep_ms(150)
    click(display, window, width.cast(I32) - 126, 168)
    for character : I8 in "alice" { key(display, character.cast(U8).cast(UPtr)) }
    key(display, 0xff0d); sleep_ms(150)
    first_path := format(home, "/.config/nostril/accounts/", pubkey, "/follows.json")
    first_follows := File.readfile(first_path)
    assert(nostril_follows_valid(first_follows, pubkey) && first_follows.contains(second))
    assert(!first_follows.contains("npub") && !first_follows.contains("nostr:"))
    assert(nostril_follows_petname(first_follows, pubkey, second) == "alice")
    click(display, window, width.cast(I32) - 150, 24)
    for character : I8 in "discard this draft" { key(display, character.cast(U8).cast(UPtr)) }
    assert(!composer_is_empty(display, window, height, empty))
    click(display, window, 90, 24)
    click(display, window, 90, 150)
    assert(composer_is_empty(display, window, height, empty))
    click(display, window, width.cast(I32) - 60, 24)
    for character : I8 in nostril_public_key_npub(pubkey) { key(display, character.cast(U8).cast(UPtr)) }
    click(display, window, width.cast(I32) - 50, 105)
    click(display, window, width.cast(I32) - 126, 168)
    for character : I8 in "bob" { key(display, character.cast(U8).cast(UPtr)) }
    click(display, window, width.cast(I32) - 50, 174)
    second_path := format(home, "/.config/nostril/accounts/", second, "/follows.json")
    second_follows := File.readfile(second_path)
    assert(nostril_follows_valid(second_follows, second) && second_follows.contains(pubkey))
    assert(nostril_follows_petname(second_follows, second, pubkey) == "bob")
    assert(File.readfile(first_path) == first_follows)
    click(display, window, 90, 24)
    click(display, window, 90, 116)
    click(display, window, width.cast(I32) - 60, 24)
    click(display, window, width.cast(I32) - 126, 168)
    click(display, window, 60, 226)
    cleared := File.readfile(first_path)
    assert(nostril_follows_valid(cleared, pubkey) && nostril_follows_petname(cleared, pubkey, second) == "")
    click(display, window, width.cast(I32) - 126, 168)
    for character : I8 in "renamed" { key(display, character.cast(U8).cast(UPtr)) }
    click(display, window, width.cast(I32) - 50, 174)
    renamed := File.readfile(first_path)
    assert(nostril_follows_petname(renamed, pubkey, second) == "renamed")
    click(display, window, width.cast(I32) - 50, 168)
    removed := File.readfile(first_path)
    assert(nostril_follows_valid(removed, pubkey) && !removed.contains(second))
    assert(File.readfile(second_path) == second_follows)
    // A local petname replaces the feed's author label immediately; clearing
    // it restores the fallback without changing the note or another account.
    click(display, window, width.cast(I32) - 150, 24)
    for character : I8 in "petname label" { key(display, character.cast(U8).cast(UPtr)) }
    key(display, 0xff0d); sleep_ms(150)
    ref unnamed : Dynamic = XGetImage(display, window, 22, height.cast(I32) - 134, 180, 24, 0xffffff, 2)
    if unnamed.is_null() { panic("could not capture author label") }
    click(display, window, width.cast(I32) - 60, 24)
    click(display, window, width.cast(I32) - 60, 56)
    paste(display)
    key(display, 0xff0d); sleep_ms(150)
    self_follow := File.readfile(first_path)
    assert(nostril_follows_valid(self_follow, pubkey) && self_follow.contains(format("[\"p\",\"", pubkey, "\"")))
    assert(!self_follow.contains("npub"))
    click(display, window, width.cast(I32) - 126, 168)
    // Paste into a petname field too, to check the exact copied representation
    // is canonical npub rather than another accepted input such as hex.
    paste(display)
    click(display, window, width.cast(I32) - 50, 174)
    copied_name := File.readfile(first_path)
    assert(nostril_follows_petname(copied_name, pubkey, pubkey) == nostril_public_key_npub(pubkey))
    click(display, window, width.cast(I32) - 150, 24)
    assert(!region_matches(display, window, 22, height.cast(I32) - 134, unnamed))
    click(display, window, width.cast(I32) - 60, 24)
    click(display, window, width.cast(I32) - 126, 168)
    click(display, window, 60, 226)
    click(display, window, width.cast(I32) - 150, 24)
    assert(region_matches(display, window, 22, height.cast(I32) - 134, unnamed))
    assert(File.readfile(second_path) == second_follows)
    XDestroyImage(unnamed)
    // Create directly in the GUI. Duplicate names preserve the current account
    // and do not publish a catalog; a successful creation selects a fresh owner.
    click(display, window, 90, 24)
    click(display, window, width.cast(I32) - 80, 90)
    for character : I8 in "gui-test" { key(display, character.cast(U8).cast(UPtr)) }
    key(display, 0xff0d); sleep_ms(150)
    catalog_path := format(home, "/.config/nostril/accounts/catalog.tsv")
    assert(!File.exists(catalog_path))
    for _index in 0..8 { key(display, 0xff08) }
    for character : I8 in "fresh" { key(display, character.cast(U8).cast(UPtr)) }
    click(display, window, width.cast(I32) - 60, 174)
    assert(composer_is_empty(display, window, height, empty))
    catalog := File.readfile(catalog_path)
    lines := catalog.split("\n")
    assert(lines.len() == 3 && lines[0] == "nostril-accounts-v1")
    fields := lines[1].split("\t")
    assert(fields.len() == 2)
    fresh := fields[0].clone()
    assert(fields[1] == "fresh" && nostril_key_encoding(fresh))
    assert(fresh != pubkey && fresh != second)
    assert(File.readfile(format(home, "/.config/nostril/init.til")) == configured)
    click(display, window, width.cast(I32) - 60, 24)
    for character : I8 in nostril_public_key_npub(pubkey) { key(display, character.cast(U8).cast(UPtr)) }
    key(display, 0xff0d); sleep_ms(150)
    fresh_path := format(home, "/.config/nostril/accounts/", fresh, "/follows.json")
    fresh_follows := File.readfile(fresh_path)
    assert(nostril_follows_valid(fresh_follows, fresh) && fresh_follows.contains(pubkey))
    assert(File.readfile(second_path) == second_follows)
    assert(File.is_file(format(home, "/.config/nostril/accounts/", fresh, "/secret.key")))
    XDestroyImage(empty)
    key(display, 0xff1b)
    status := app.wait()
    if status != 0 { panic("GUI exit failed: ", app.out(), app.err()) }
    // A catalog account is usable on a fresh launch with no init at all.
    File.remove(format(home, "/.config/nostril/init.til"))
    restarted := Cmd.new("timeout", "30", executable)
    restarted.env("HOME", home).env("XDG_CONFIG_HOME", "").capture()
    restarted.start()
    mut restarted_window : UPtr = 0
    attempts = 0
    while restarted_window == 0 && !restarted.poll() && attempts < 100 {
        restarted_window = find_window(); sleep_ms(50); attempts++
    }
    if restarted_window == 0 { panic("created account did not restart: ", restarted.out(), restarted.err()) }
    XSetInputFocus(display, restarted_window, 1, 0); XFlush(display); sleep_ms(150)
    click(display, restarted_window, width.cast(I32) - 60, 24)
    for character : I8 in nostril_public_key_npub(second) { key(display, character.cast(U8).cast(UPtr)) }
    key(display, 0xff0d); sleep_ms(150)
    reloaded_follows := File.readfile(fresh_path)
    assert(nostril_follows_valid(reloaded_follows, fresh) && reloaded_follows.contains(second) && reloaded_follows.contains(pubkey))
    assert(File.readfile(catalog_path) == catalog && File.readfile(second_path) == second_follows)
    key(display, 0xff1b)
    if restarted.wait() != 0 { panic("restarted GUI failed: ", restarted.out(), restarted.err()) }
    XCloseDisplay(display)
    File.remove_tree(home)
    println("GUI sending, switching, follows/petnames, npub copy/paste and account creation/restart passed")
}
