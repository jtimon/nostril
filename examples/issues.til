mode cli
import("std/file")

main := proc() {
    mut numbers := Set(I64).new()
    mut open_issues := Map(I64, Str).new()
    next_text := File.readfile("issues/NEXT_ISSUE.txt")
    next := next_text.trim().to_i64()
    categories := array(Str, "bugs", "cleanups", "features", "optimizations",
        "backends", "experiments", "examples", "deferred", "unknown")
    for directory : Str in array(Str, "open", "fixed", "cancelled") {
        for name : Str in Dir.list(format("issues/", directory)) {
            if !name.ends_with(".org") { continue }
            number := name.substr(0, name.len() - 4).to_i64()
            if number <= 0 || number >= next || numbers.has(number) { panic("invalid or duplicate issue number: ", name) }
            numbers.add(own number.clone())
            text := File.readfile(format("issues/", directory, "/", name))
            lines := text.split("\n")
            if lines.len() < 3 { panic("incomplete issue: ", name) }
            if !lines[0].starts_with("# priority: ") || !lines[1].starts_with("# category: ") { panic("missing issue metadata: ", name) }
            priority := lines[0].strip_prefix("# priority: ")
            category := lines[1].strip_prefix("# category: ")
            if priority != "high" && priority != "medium" && priority != "low" { panic("invalid priority: ", name) }
            mut known := false
            for candidate : Str in categories { if candidate == category { known = true } }
            if !known { panic("invalid category: ", name) }
            mut title := ""
            for line : Str in lines { if line.starts_with("** ") { title = line.clone(); break } }
            mut state := "FIXED"
            if directory == "cancelled" { state = "CANCELLED" }
            else if directory == "open" {
                state = "OPEN"
                if title.starts_with("** WIP ") { state = "WIP" }
            }
            heading := format("** ", state, " #", number.to_str(), " ")
            if !title.starts_with(heading) { panic("issue heading mismatch: ", name) }
            if directory == "open" {
                open_issues.set(number, own format(category, "\n", priority, "\n", title.strip_prefix(heading)))
            }
        }
    }
    mut summary := "* Open Nostril issues\n\nGenerated by examples/issues.til; do not edit.\n"
    for category : Str in categories {
        mut section := ""
        for priority : Str in array(Str, "high", "medium", "low") {
            mut entries := ""
            for number : I64 in numbers {
                if !open_issues.has(number) { continue }
                data := open_issues[number].split("\n")
                if data[0] == category && data[1] == priority {
                    entries = format(entries, "**** [[file:open/", number.to_str(), ".org][#", number.to_str(), "]] ", data[2], "\n")
                }
            }
            if entries.len() > 0 { section = format(section, "*** ", priority, "\n", entries) }
        }
        if section.len() > 0 { summary = format(summary, "** ", category, "\n", section) }
    }
    File.writefile("issues/summary.org", summary)
    println("Generated: issues/summary.org")
}
